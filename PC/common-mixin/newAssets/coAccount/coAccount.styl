.futures-account-page {
  position: relative;
  width: 100%;
  height: 100%;
  .futures-account-header {
    margin-bottom: 10px;
    padding: 24px 24px 28px 24px;
    border-radius: 8px;
    .button {
      float: right;
      .common-button {
        margin-left:20px;
        .common-button-slot {
          vertical-align: initial;
        }
      }
    }
    h1 {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 24px;
      line-height: 33px;
      .hide-assets {
        display: inline-block;
        width: 24px;
        height: 24px;
        border-radius: 4px;
        text-align: center;
        line-height: 24px;
        cursor: pointer;
        margin-left: 12px;
        .icon {
          vertical-align: 0.21em;
        }
      }
    }
    h4 {
      font-size: 14px;
      line-height: 16px;
      font-weight: 600;
      margin-bottom: 12px;
      }
    p {
      font-size: 24px;
      line-height: 31px;
      height: 31px;
      font-weight: 500;
      font-family: HarmonyOS-Medium;
      span {
        font-size: 14px;
        line-height: 31px;
        font-weight: 500;
      }
    }
    .futures-header-bar {
      display: flex;
    }
  }
  .futures-account-main {
    min-height 622px;
    border-radius: 8px;
  }
  .exchangeAccount-title {
    height: 60px;
    line-height: 60px;
    border-bottom-style: solid;
    border-bottom-width: 1px;
    padding: 0 20px;
    vertical-align: middle;
    margin-bottom: 2px;
    display:flex;
    .text {
      display: inline-block;
      margin-right: 16px;
      font-size: 16px;
      font-weight: 500;
      float: left;
    }
    .common-checkout {
      float: left;
      .icon-12 {
        vertical-align: -0.1em;
      }
    }
    .hodetext {
      margin-left: 4px;
      font-size: 12px;
      cursor pointer;
      user-select: none;
      float: left;
    }
    .find {
      float: right;
      border-width: 0;
      border-style: solid;
      border-radius: 50px;
      line-height: 30px;
      height: 32px;
      padding: 0 5px;
      margin-top: 14px;
      .input-find-content {
        line-height: 30px;
        height: 32px;
        border-width: 1px;
        border-style: solid;
        border-radius: 50px;
        .iconbox {
          vertical-align: initial;
        }
      }
      .clones {
        line-height: 28px;
      }
    }

  }
  .exchangeAccount-center {
    width: 100%;
    box-sizing: border-box;
    padding: 0 20px;
    font-family: HarmonyOS-Medium;
    .table-head {
      margin-top: 14px;
      th {
        text-align: left;
        &:last-child {
          text-align: right;
          padding-right: 10px;
        }
      }
    }
    .table-body {
      td {
        text-align: left;
        font-size: 14px;
        line-height: 18px;
        font-weight: 500;
        &:last-child {
          text-align: right;
        }
        .common-button {
          background: none !important;
        }
      }
      .common-button {
        background: none !important;
      }
    }
    .symbol-td {
      .symbol-icon {
        width: 24px;
        height: 24px;
        float: left;
        margin-top: 4px;
      }
      .symbol-name {
        float: left;
        margin-left: 12px;
        height: 35px;
        h5 {
          font-size: 16px;
          line-height: 18px;
          font-weight: 500;
          margin-bottom: 3px;
        }
        .notlongTitle {
          margin-top: 8px;
        }
        p {
          font-size: 12px;
          font-weight: normal;
        }
      }
    }
  }
  .coAccount-header-bg {
      background-image: linear-gradient(-269deg, #0491ce 0%, #00aeb6 100%);
    }
  .coAccount-header {
    background-position: right bottom !important;
    background-repeat: no-repeat !important;
  }
  .yesterday-profit {
    margin-left: 130px;
    flex: 1;
    .enter-title {
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 10px;
      position: relative;
      cursor pointer
      span {
        border-bottom-style: dashed;
        border-bottom-width: 1px;
      }
      .icon-box {
        width: 16px;
        height: 16px;
        text-align: center;
        line-height: 16px;
        display: inline-block;
        margin-left: 4px;
        border-radius: 2px;
        position: relative;
        .icon {
          width: 0.5em;
          height: 0.5em;
          vertical-align: 0.1em;
        }
        .layout {
          position: absolute;
          width: 100%;
          height: 100%;
          border-radius: 2px;
          left: 0;
          top: 0;
          background: rgba(0, 0, 0, 0.1);
        }
      }
      .profitTip {
        word-break: break-all
        box-shadow: 0 3px 4px 1px rgba(0,0,0,0.28);
        position absolute
        bottom 26px
        width 332px
        padding 12px
        left 0
        transform: translate(-45%, 0);
        box-sizing border-box
        border-radius: 4px;
        font-size 12px
        letter-spacing 0
        line-height 20px
        z-index 4
      }
      .triangle {
        position: absolute;
        bottom: -11px;
        left: 50%;
        border: 6px solid;
        border-bottom-color: transparent!important;
        border-left-color: transparent!important;
        border-right-color: transparent!important;
        z-index: -1;
      }
    }
    .profit-detail {
      padding-bottom: 4px;
      span:first-child {
        font-size: 20px;
        line-height: 28px;
        font-weight: 500;
      }
      span:last-child  {
        font-size: 14px;
        padding-left: 16px;
      }
    }
  }
  .go-coProfitRecord {
    flex: 1;
    text-align: right;
    padding-top: 22px;
    font-size: 14px;
    max-width: 120px;
    .bar {
      display: inline-block;
      cursor: pointer;
    }
  }
}
.hide {
  flex: 1;
  display: flex;
  align-items: center;
  .hidetext {
    padding-left: 4px;
    font-size: 12px;
  }
  .icon {
    vertical-align: 0;
  }
}
// 国际版
.Int {
  .coAccount-header {
    padding: 40px 0 20px 0;
  }
  .coAccount-header,
  .exchangeAccount-body {
    width: 940px;
    margin: 0 auto;
  }
  .exchangeAccount-title,
  .exchangeAccount-center {
    padding: 0;
  }
}
.navMenu .navMenuList li.min-medium {
  display: none;
}
