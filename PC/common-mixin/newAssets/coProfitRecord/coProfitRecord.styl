.assets-profitRecord {
  width: 100%;
  font-family: HarmonyOS-Medium;
  .slide-fade-enter-active {
    transition: all .5s;
  }
  .slide-fade-leave-active {
    transition: all .5s;
  }
  .slide-fade-enter, .slide-fade-leave-to {
    transform: translateY(-5px);
    opacity: 0;
  }
  .profitRecord-header {
    width: 100%;
    padding: 24px 0 28px 24px;
    border-radius: 8px;
    margin-bottom: 28px;
    box-sizing: border-box;
    .title {
      font-size: 24px;
      line-height: 33px;
      display: flex;
      align-items: center;
      margin-bottom: 24px;
      .title-goBack {
        cursor: pointer;
      }
      .icon-20 {
        margin-right: 12px;
      }
      .hide-assets {
        margin-left: 12px;
        font-size: 12px;
        padding: 0 8px;
        height: 24px;
        line-height: 24px;
        border-radius: 4px;
        border-width: 1px;
        border-style: solid;
        box-sizing: border-box;
        cursor: pointer;
      }
    }
    .detail-num {
      display: flex;
      padding-left: 24px;
      .total-num {
        // flex: 1;
        .folded-text {
          font-size: 14px;
          line-height: 16px;
          margin-bottom: 12px;
        }
        .folded-num {
          b {
            display: inline-block;
            font-size: 24px;
            line-height: 31px;
            font-weight: 600;
          }
          span {
            font-size: 14px;
          }
        }
      }
      .PNL {
        flex: 1;
        display: flex;
        margin-left: 130px;
        // justify-content: space-around;
        .thirty-PNL {
          margin-left: 130px;
        }
      }
      .yesterday-PNL, .thirty-PNL {
        .PNL-title {
          font-size: 14px;
          margin-bottom: 10px;
          position: relative;
          cursor pointer
          span {
            border-bottom-style: dashed;
            border-bottom-width: 1px;
          }
          .icon-box {
            width: 16px;
            height: 16px;
            text-align: center;
            line-height: 16px;
            display: inline-block;
            margin-left: 4px;
            border-radius: 2px;
            .icon {
              width: 0.5em;
              height: 0.5em;
              vertical-align: 0;
            }
          }
          .profitTip {
            word-break: break-all
            box-shadow: 0 3px 4px 1px rgba(0,0,0,0.28);
            position absolute
            bottom 26px
            width 332px
            padding 12px
            left 0
            transform: translate(-40%, 0);
            box-sizing border-box
            border-radius: 4px;
            font-size 12px
            letter-spacing 0
            line-height 20px
            z-index 4
          }
          .triangle {
            position: absolute;
            bottom: -11px;
            left: 45%;
            border: 6px solid;
            border-bottom-color: transparent!important;
            border-left-color: transparent!important;
            border-right-color: transparent!important;
            z-index: -1;
          }
        }
        .PNL-detail {
          span:first-child {
            font-size: 24px;
            line-height: 28px;
            font-weight: 500;
          }
          span:last-child {
            font-size: 14px;
            padding-left: 16px;
          }
        }
      }
    }
  }
  .time-range {
    margin-bottom: 16px;
    display: flex;
    .date-select_wrap {
      display: flex;
      align-items: center;
      .line {
        padding: 10px 8px 0;
      }
    }
  }
  .time-select {
    display: flex;
    .time-item {
      min-width: 66px;
      height: 32px;
      padding: 0 12px;
      border-radius: 4px;
      border-style: solid;
      border-width: 1px;
      box-sizing: border-box;
      text-align: center;
      line-height: 30px;
      margin-right: 12px;
      cursor: pointer;
      transition: 0.3s;
    }
  }
  .echarts-wrap {
    display: flex;
    .PNL-echart {
      flex-shrink: 0;
      width: 700px;
      margin-right: 20px;
      .echart-item {
        height: 216px;
      }
    }
    .assets-echart {
      width: 460px;
      flex-shrink: 0;
    }
    .echart-item {
      width: 100%;
      padding: 24px;
      border-radius: 8px;
      margin-bottom: 20px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      font-size: 12px;
      &.assets-distribute {
        height: 300px;
      }
      &.assets-total {
        height: 368px;
      }
    }
    .echart-title {
      font-size: 16px;
      line-height: 24px;
      position: relative;
      .help-icon {
        display: inline-block;
        margin-left: 6px;
        cursor: help;
        position: relative;
        .icon {
          vertical-align: 0;
        }
      }
      .tipText {
        word-break: break-all
        box-shadow: 0 3px 4px 1px rgba(0,0,0,0.28);
        position absolute
        bottom 28px
        max-width 340px
        padding 8px 12px
        left 50%
        transform translate(-50%, 0)
        box-sizing border-box
        border-radius: 4px;
        font-size 12px
        letter-spacing 0
        line-height 20px
        z-index 4
      }
      .num {
        display: inline-block;
        font-size: 14px;
        margin-left: 12px;
      }
      .echart-legend {
        position: absolute;
        right: 0;
        top: -10px;
        // bottom: 0;
        // display: flex;
        li {
          margin-right: 20px;
          display: flex;
          align-items: center;
          font-size: 12px;
          i {
            width: 4px;
            height: 4px;
            background: #2762FF;
            margin-right: 4px;
            border-radius: 100%;
          }
          &:last-child i {
            background: #769CFF;
          }
        }
      }
    }
    .echart-box {
      flex: 1;
      position: relative;
    }
    .profit-block {
      display: flex;
      padding-top: 30px;
      margin-bottom: 28px;
      .profit-item {
        flex: 1;
        padding-left: 8px;
        .profit-title {
          display: inline-block;
          position: relative;
          .spot {
            width: 6px;
            display: inline-block;
            height: 6px;
          }
          .help-icon {
            display: inline-block;
            margin-left: 6px;
            border-bottom-style: dashed;
            border-bottom-width: 1px;
            padding-bottom: 2px;
          }
        }
        .profit-value {
          font-size: 24px;
          line-height: 30px;
          padding-top: 4px;
        }
      }
    }
    .coin-list {
      display: flex;
      flex-wrap: wrap;
      margin: 0 -6px;
      .coin-item {
        width: 45%;
        height: 28px;
        padding: 0 12px;
        margin-bottom: 4px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 4px;
        box-sizing: border-box;
        margin: 0 6px;
        .spot {
          display: inline-block;
          width: 6px;
          height: 6px;
          border-radius: 1px;
          vertical-align: middle;
          margin-right: 8px;
        }
        .profit-title {
          position: relative;
          .help-icon {
            display: inline-block;
            border-bottom-style: dashed;
            border-bottom-width: 1px;
            padding-bottom: 2px;
          }
        }
      }
    }
  }
  .warn-tip {
    line-height: 38px;
    font-size: 12px;
  }
  .small_unit {
    font-size: 12px;
  }
}
