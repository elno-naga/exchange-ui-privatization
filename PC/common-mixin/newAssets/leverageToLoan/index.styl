.v5-page-leverafeToLoan {
  .slide-fade-enter-active {
    transition: all .5s;
  }
  .slide-fade-leave-active {
    transition: all .5s;
  }
  .slide-fade-enter, .slide-fade-leave-to {
    transform: translateY(-5px);
    opacity: 0;
  }
  .toLoan-form {
    //border-radius: 8px;
  }
  .toLoan-header {
    padding: 36px 0 0 40px;
    font-size: 20px;
    line-height: 28px;
    .icon {
      cursor pointer
      margin-right: 16px;
    }
  }
  .toLoan-details {
    padding: 32px 0 40px 40px;
    display: flex;
    position: relative;
    justify-content:center;
    .cut-line {
      width: 1px;
      height: 336px;
      margin: 26px 105px 0 174px;
    }
    .details-left {
      width: 270px;
    }
    .symbol {
      font-size: 20px;
      font-weight: 500;
      line-height: 26px;
    }
    .numberList {
      width: 100%;
      line-height: 16px;
      font-size: 12px;
      margin-top: 32px;
      display: flex;
      justify-content: space-between;
      li {
        margin-bottom: 16px;
        &:last-child {
          margin-bottom: 0;
        }
        .even-button {
          margin-left: 16px;
          font-size: 12px;
        }
      }
    }
    .numberList-key {
      text-align: left;
    }
    .numberList-value {
      text-align: right;
    }
    .details-warking {
      width: 100%;
      font-size: 12px;
      line-height: 16px;
      margin-top: 60px;
    }
    .coinType {
      .form-title {
        font-size: 12px;
        line-height: 16px;
        margin-bottom: 10px;
      }
      .coin-list {
        display: flex;
        flex-wrap: wrap;
        width: 378px;
        li {
          font-size 14px
          height 32px
          min-width 66px
          padding: 0 8px;
          box-sizing: border-box;
          text-align: center;
          cursor pointer
          line-height 32px
          border-radius 4px
          margin-right: 12px;
          margin-bottom: 16px;
        }
      }
    }
    .coinDeat {
      margin-bottom: 32px;
      li {
        width: 378px;
        height: 32px;
        line-height: 32px;
        border-radius: 4px;
        box-sizing: border-box;
        padding: 0 16px;
        display: flex;
        justify-content: space-between;
        margin-bottom: 1px;
        position: relative;
        &:last-child {
          margin-bottom: 0;
        }
      }
      .tolanIcon {
        display: inline-block;
        margin-left: 8px;
        .icon {
          vertical-align: 0;
        }
        .iconMark {
          word-break: break-all
          box-shadow: 0 3px 4px 1px rgba(0,0,0,0.28);
          position absolute
          top 33px
          width 378px
          padding 20px
          left 0
          box-sizing border-box
          border-radius: 4px;
          font-size 12px
          letter-spacing 0
          line-height 20px
          z-index 4
        }
      }
    }
    .submit-btn {
      margin-top: 52px;
    }
  }
  .toLoanRecord {
    margin-top: 5px;
    //border-radius: 8px;
    padding-bottom: 50px;
    .toLoanRecord-title {
      width: 100%;
      height: 54px;
      padding-left: 24px;
      margin-bottom: 20px;
      line-height: 54px;
      position: relative;
      box-sizing: border-box;
      border-bottom-style: solid;
      border-bottom-width: 1px;
      font-size: 14px;
      .title-text {
        position: relative;
        display: inline-block;
        height: 100%;
      }
      .title-line {
        position: absolute;
        width: 40px;
        height: 2px;
        border-radius: 2px 2px 0px 0px;
        left: 50%;
        bottom: 0;
        margin-left: -20px;
      }
      .all-record {
        cursor: pointer;
        position: absolute;
        font-size: 14px;
        line-height: 30px;
        right: 24px;
        top: 12px;
      }
    }
    .table-coin {
      display: flex;
      align-items: center;
      img {
        width: 24px;
        height: 24px;
        border-radius: 100%;
        margin-right: 12px;
      }
      dd {
        line-height: 18px;
      }
      .coinShowName {
        font-size: 16px;
        font-weight: 500;
      }
      .coinLongName {
        font-size: 12px;
      }
    }
    .operation-btn {
      margin-right: 20px;
      &:last-child {
        margin-right: 0;
      }
    }
  }
  .assets-loading {
    position: fixed;
    top: 50%;
    left: 50%;
    margin-top: -25px;
    margin-left: -25px;
    z-index: 1000;
  }
}
.Int {
  .v5-page-leverafeToLoan {
    width: 940px;
    margin: 0 auto;
    .toLoan-table,
    .toLoan-header {
      padding: 0;
    }
    .toLoan-details {
      padding-left: 0;
      border: none;
    }
  }
}
