    display: flex;
    position: relative;
    justify-content:space-between;
    .withdraw-tab {
      margin-bottom: 27px;
      display: flex;
      .tabItem {
        height: 32px;
        padding: 0 18px;
        font-size: 14px;
        text-align: center;
        line-height: 32px;
        border-width: 1px;
        border-style: solid;
        border-radius: 4px;
        margin-right: 12px;
        cursor: pointer;
        &:last-child {
          margin-right: 0;
        }
      }
    }
    .cut-line {
      width: 1px;
      height: 336px;
      margin: 27px 80px 0 80px;
    }
    .details-left {
      width: 340px;
    }
    .numberList {
      width: 100%;
      line-height: 16px;
      font-size: 12px;
      margin-top: 20px;
      display: flex;
      justify-content: space-between;
      li {
        margin-bottom: 16px;
        &:last-child {
          margin-bottom: 0;
        }
      }
    }
    .numberList-key {
      text-align: left;
    }
    .numberList-value {
      text-align: right;
    }
    .amount-tips {
      margin-top: 32px;
      font-size: 12px;
      div {
        margin-bottom: 12px;
      }
      li {
        margin-bottom: 12px;
        line-height: 15px;
        display: flex;
        justify-content: space-between;
        span {
          text-align: left;
        }
        i {
          text-align: right;
        }
      }
    }
    .details-warking {
      width: 100%;
      font-size: 12px;
      line-height: 16px;
      margin-top: 32px;
      display: flex;
      .limit-tip {
        line-height: 20px;
      }
    }
    .withdrawMsg {
      margin-top: 30px;
      font-size: 12px;
      line-height: 18px;
    }
    .withdraw-address {
      width: 378px;
      .title {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        line-height: 16px;
