.v5-page-withdraw {
  width: 1200px;
  margin: 0 auto;
  .slide-fade-enter-active {
    transition: all .5s;
  }
  .slide-fade-leave-active {
    transition: all .5s;
  }
  .slide-fade-enter, .slide-fade-leave-to {
    transform: translateY(-5px);
    opacity: 0;
  }
  .copy {
    cursor: pointer;
  }
  .withdraw-form {
    border-radius: 8px;
  }
  .withdraw-header {
    padding: 36px 0 0 40px;
    font-size: 20px;
    line-height: 28px;
    .icon {
      cursor pointer
      margin-right: 16px;
    }
  }
  .withdraw-name{
    padding: 20px 0 20px 0;
  }

  .withdraw-details {
