.v5-page-otcAccount {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  .total-assets {
    width: 100%;
    height: 168px;
    padding: 24px;
    box-sizing: border-box;
    //border-radius: 8px;
    position: relative;
    margin-bottom: 5px;
    .icon-12 {
      font-size: 12px;
    }
    .title {
      font-size: 24px;
      font-weight: 600;
      line-height: 33px;
      margin-bottom: 24px;
    }
    .hide-assets {
      display: inline-block;
      width: 24px;
      height: 24px;
      border-radius: 4px;
      text-align: center;
      line-height: 24px;
      cursor: pointer;
      margin-left: 12px;
      .icon {
        vertical-align: 0.21em;
      }
    }
    .folded-text {
      font-size: 14px;
      line-height: 16px;
      margin-bottom: 12px;
    }
    .folded-num {
      .btcNum {
        display: inline-block;
        font-size: 24px;
        line-height: 31px;
        font-weight: 500;
      }
      .fiatNum  {
        font-size: 14px;
      }
    }
    .num-hide {
      font-size: 24px;
      line-height: 31px;
    }
    .funcButton-list {
      position: absolute;
      right: 24px;
      top: 24px;
      font-weight: 500;
      .common-button {
        margin-left: 20px;
      }
    }
  }
  .transfer-form {
    padding-bottom: 20px;
    .transfer-account {
      display: flex;
      margin-bottom: 32px;
      &.reverse {
        .exchange {
          transform: translate3d(232px, 0, 0);
        }
        .other {
          transform: translate3d(-232px, 0, 0);
        }
      }
    }
    .account-side {
      width: 184px;
      transition: all 0.3s;
    }
    .available {
      font-size: 12px;
      line-height: 16px;
      margin-top: 8px;
    }
    .change-icon {
      padding: 35px 12px 0;
      .icon {
        cursor pointer
      }
    }
    .transfer-all {
      font-size: 14px;
      margin-right: 12px;
      cursor: pointer;
    }
  }
  .transfer-symbol, .transfer-coin {
    width: 100%;
    margin-bottom: 32px;
  }
  .otcAccount-list {
    //border-radius: 8px;
    padding-bottom: 30px;
    flex: 1;
    .list-header {
      border-bottom-style: solid;
      border-bottom-width: 1px;
      padding: 12px 24px 16px;
      display: flex;
      align-items: center;
      margin-bottom: 12px;
    }
    .otcAccount-center{
      padding:10px 24px 0;
    }
    .title {
      font-size: 16px;
      margin-right: 16px;
    }
    .hide {
      flex: 1;
      display: flex;
      align-items: center;
      .hidetext {
        padding-left: 4px;
        font-size: 12px;
      }
      .icon {
        vertical-align: 0;
      }
    }
    .table-coin {
      display: flex;
      align-items: center;
      img {
        width: 24px;
        height: 24px;
        border-radius: 100%;
        margin-right: 12px;
      }
      dd {
        line-height: 18px;
      }
      .coinShowName {
        font-size: 16px;
        font-weight: 500;
      }
      .coinLongName {
        font-size: 12px;
      }
    }
    .table-btn_item {
      display: inline-block;
      position: relative;
      margin-right: 20px;
      &:last-child {
        margin-right: 0;
      }
    }
  }
  .assets-loading {
    position: fixed;
    top: 50%;
    left: 50%;
    margin-top: -25px;
    margin-left: -25px;
    z-index: 1000;
  }
}
