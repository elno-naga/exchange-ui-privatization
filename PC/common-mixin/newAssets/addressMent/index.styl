.v5-page-addressMent {
  .slide-fade-enter-active {
    transition: all .5s;
  }
  .slide-fade-leave-active {
    transition: all .5s;
  }
  .slide-fade-enter, .slide-fade-leave-to {
    transform: translateY(-5px);
    opacity: 0;
  }
  .copy {
    cursor: pointer;
  }
  .addressMent-form {
    //border-radius: 8px;
  }
  .addressMent-header {
    padding: 36px 0 28px 40px;
    font-size: 20px;
    line-height: 28px;
    border-bottom-style: solid;
    border-bottom-width: 1px;
    margin-bottom: 28px;
    .icon {
      cursor pointer
      margin-right: 16px;
    }
  }
  .add-address {
    padding-left: 40px;
    padding-bottom: 50px;
    h6 {
      font-size: 16px;
      line-height: 22px;
      margin-bottom: 28px;
    }
  }
  .withdraw-addAddress {
    width: 416px;
  }
  .valid-form_item {
    margin-bottom: 32px;
    &:last-child {
      margin-bottom: 0;
    }
  }
  .addressmentRecord {
    margin-top: 5px;
    //border-radius: 8px;
    padding-bottom: 50px;
    .addressmentRecord-title {
      width: 100%;
      height: 54px;
      padding-left: 24px;
      margin-bottom: 20px;
      line-height: 54px;
      position: relative;
      box-sizing: border-box;
      border-bottom-style: solid;
      border-bottom-width: 1px;
      font-size: 14px;
      .title-text {
        position: relative;
        display: inline-block;
        height: 100%;
      }
      .title-line {
        position: absolute;
        width: 40px;
        height: 2px;
        border-radius: 2px 2px 0px 0px;
        left: 50%;
        bottom: 0;
        margin-left: -20px;
      }
      .all-record {
        cursor: pointer;
        position: absolute;
        font-size: 14px;
        line-height: 30px;
        right: 24px;
        top: 12px;
      }
    }
    .address-qrcode {
      position: relative;
      word-break: break-all;
      .icon {
        margin-right: 4px;
      }
      .long-value {
        visibility: hidden;
        transform: translateY(-5px);
        opacity: 0;
        position: absolute;
        max-width: 340px;
        padding: 8px 12px;
        left: 18px;
        top: 22px;
        box-sizing: border-box;
        box-shadow: 0px 3px 4px 1px rgba(0,0,0,0.28);
        border-radius: 4px;
        word-break: break-all;
        z-index: 2;
        transition: all 0.5s;
      }
      .label-address-type{
        padding:2px 4px;
        font-size:12px;
        font-weight:500;
        font-family: HarmonyOS-Medium;
        margin-left:8px;
      }
      .col-value:hover {
        .long-value {
          visibility: visible;
          opacity: 1;
          transform: translateY(0);
        }
      }
    }
  }
  .qrcode-img {
    width: 120px;
    height: 120px;
    position: fixed;
    background: #FFFFFF;
    box-shadow: 0px 3px 4px 1px rgba(0,0,0,0.28);
    border-radius: 4px;
    bottom: 22px;
    left: -54px;
    box-sizing: border-box;
    img {
      width: 100%;
      height: 100%;
      border-radius: 4px;
    }
    &::after {
      position: absolute;
      content: '';
      border: 6px solid transparent;
      border-top-color: #ffffff;
      bottom: -11px;
      left: 55px;
    }
  }
}
