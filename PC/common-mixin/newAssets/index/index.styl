.v5-assets {
  //width:1180px;
  min-height: 800px;
  //margin: 32px auto 60px auto;
  margin: 5px auto 5px auto;
  box-sizing: border-box;
  position: relative;
  display: flex;
  font-family: HarmonyOS-Medium;
  .icon-12 {
    font-size: 12px;
  }
  .box-shadow {
    box-shadow: 0px 3px 4px 1px rgba(0,0,0,0.28)!important;
  }
  &.light-theme {
    .box-shadow {
      box-shadow: 0px 1px 4px 1px rgba(0,0,0,0.06)!important;
    }
  }
  .alertTitle {
    font-size: 14px;
    line-height: 22px;
    margin-bottom: 16px;
  }
  input {
    font-family: HarmonyOS-Medium;
  }
  .nav-wrap {
    width: 240px;
    margin-right: 5px;
  }
  .assets-nav {
    position: absolute;
    width: 190px;
    height: 100%;
    min-height: 800px;
    margin-right: 10px;
    border-radius: 8px;
    .nav-item {
      width: 100%;
      height: 56px;
      line-height: 56px;
      padding-left: 16px;
      box-sizing: border-box;
      position: relative;
      cursor: pointer;
      font-weight: 600;
      .icon {
        margin-right: 16px;
      }
      .active-line {
        position: absolute;
        left: 0;
        top: 0;
        width: 3px;
        height: 100%;
        border-radius: 2px 0px 0px 2px;
      }
    }
  }
  .assets-view {
    flex: 1;
    flex-shrink: 0;
    min-height: 800px;
  }

  .popover_addressOverview {
    word-break: break-all;
  }
}
