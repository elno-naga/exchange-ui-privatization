.v5-order-main{
  min-height: 800px;
  margin: 5px auto 5px auto;
  box-sizing: border-box;
  position: relative;
  font-family: HarmonyOS-Medium;
  display:flex;
  .box-shadow {
    box-shadow: 0px 3px 4px 1px rgba(0,0,0,0.28)!important;
  }
  &.light-theme {
    .box-shadow {
      box-shadow: 0px 1px 4px 1px rgba(0,0,0,0.06)!important;
    }
  }
}
.order-title {
  height: 56px;
  line-height: 56px;
  padding-left: 20px;
  font-size: 16px;
}
.margin-left{
    width: 240px;
    margin-right: 5px;
    .order-nav{
      position: absolute;
      width: 190px;
      height: 100%;
      min-height: 800px;
      margin-right: 10px;
      border-radius: 8px;
      left:0;
      .nav-item {
        width: 100%;
        height: 56px;
        line-height: 56px;
        padding-left: 16px;
        box-sizing: border-box;
        position: relative;
        cursor: pointer;
        font-weight: 500;
        &:first-child {
          border-top-right-radius: 8px;
        }

        .icon {
          margin-right: 16px;
        }
        .active-line {
          position: absolute;
          left: 0;
          top: 0;
          width: 3px;
          height: 100%;
          border-radius: 2px 0px 0px 2px;
        }
    }
    }
}
.margin-right{
  flex:1;
  min-height: 800px;
  .__vuescroll{
    border-radius: 8px;
  }
}
.Int {
  .order-page-box {
    height: 100%;
  }
  .order-main{
    margin: 0;
    width: auto;
    height: 100%;
    padding-left: 195px;
    .assets-page-title  {
        height: 80px;
        line-height: 80px;
        margin-bottom: 5px;
        .page-title-bar {
          width: 940px;
          margin: 0 auto;
          font-size: 16px;
        }
      }
    .margin-left {
      height: 100%;
    }
    .margin-right {
      width: auto;
      height: calc(100% - 85px);
      .margin-right-bar {
        width: 940px;
        margin: 0 auto;
        .otcOrder-options,
        .otcOrder-table,
        .otcOrder-nav,
        .exchangeOrder-table,
        .exchangeOrder-options,
        .exchangeOrder-nav {
          padding: 0;
        }
      }
    }
  }
}
.order-h5 {
  display: none;
}
.margin-left-h5 {
  display: none;
}
.h5-evenMenus-list {
  float: right;
  margin-right: 20px;
  font-size: 20px;
  display: none;
}
// ��Ӧʽ
@media (max-width: 600px) {
    .menus-fade-enter-active {
    transition: all .4s ease;
  }
  .menus-fade-leave-active {
    transition: all .4s ease;
  }
  .menus-fade-enter, .menus-fade-leave-to {
    transform: translateX(-100%);
    opacity: 0;
  }
  .margin-left-h5 {
    display: block;
    z-index: 3;
  }
  .margin-left-h5-body {
    height: calc(100% - 96px);
    overflow-y: scroll;
  }
  .margin-left-pc {
    display: none;
  }

  .order-pc {
    display: none;
  }
  .order-h5 {
    display: block;
  }
  .order-main {
    width: 100%;
    padding: 5px;
    margin-top 5px;
  }
  .margin-left {
    position: fixed !important;
    width: 100% !important;
    height: calc(100% - 40px);
    top: 40px;
    .navMenu {
      width: 100% !important;
    }
  }
  .h5-evenMenus-list {
    display: block !important;
  }
  .margin-right {
    width: 100%;
    overflow: auto;
    .margin-right-bar {
      width: 100%;
    }
  }
  .page-otcOrder .otcOrder-nav,
  .page-exchangeOrder .exchangeOrder-nav {
    padding: 0 18px !important;
    .c_list_nav li {
      margin-right: 20px !important;
    }
    .exchangeOrder-nav-switchs {
      right: 18px !important;
    }
  }

}
@media (max-width: 460px) {
  .order-main {
    .margin-right {
      .common-select {
        width: 100% !important;
        margin: none !important;
        margin-right: 0px!important;
      }
    }
  }
}
