

.stop-order-mode {
  .dialog-frame {
    //width: 580px !important;
    height: auto !important;
    .dialog-frame-body {
      width: auto !important;
      //margin: 0 40px;
    }
  }
}
.stopOrderMode-box {
  table {
    width: 100%;
    td, th {
      padding: 7px 0 !important;
      text-align: center !important;
      &:first-child {
        text-align: left !important;
        padding-left: 20px !important;
      }
      &:last-child {
        text-align: right !important;
        padding-right 20px  !important
      }
    }
    .thead {
      border-width: 0 !important;
    }
  }

  .stopOrderMode-currentInfo {
    display: flex;
    padding: 12px; 16px;
    border-radius: 4px;
    justify-content: space-between;

    .info-key {
      font-size: 14px;
      line-height: 16px;
      margin-bottom: 8px;
    }

    .info-value {
      font-size: 14px;
      line-height: 16px;
    }

    li:last-child {
      text-align: right;
    }
  }
  .block-title {
    padding-top: 24px;
    margin-bottom: 10px;
    // height: 32px;
    // line-height: 32px;
    position: relative;
    .tit {
      font-size: 16px;
      margin-right: 34px;
      cursor: pointer;
      user-select: none;
      margin-top: 10px;

      &:last-child {
        margin-right: 0;
      }
    }
  }
  .block-box {
    //min-height: 224px;
  }
  .form-block {
    width: 100%;
    font-size: 12px;
    display: flex;
    .select-price {
      margin-top: 10px;
      flex: 1;
      .form-control {
        height: 40px;
        line-height: 40px;
        input {
          width: 170px;
        }
        span {
          user-select: none;
        }
        .unit {
          padding-right: 20px;
        }
      }
      &.limit-price {
        margin-left: 12px;
      }
    }
  }
  .tip-takeAmount {
    margin: 10px 0 10px;
    font-size: 12px;
    line-height: 18px;
  }
  .form-info {
    margin-bottom: 20px;
    width: 290px;
    float: right;
    margin: 18px 0 0;
    .info-item {
      margin-bottom: 1px;
      display: flex;
      box-sizing: border-box;
      font-size: 12px;
      height: 66px;
      align-items: center;
      p {
        flex: 1;
        padding: 10px 0 10px 10px;
      }
      .text1 {
        max-width: 120px;
      }
      .text2 {
        text-align: right;
        border-left-width: 1px;
        border-left-style: solid;
        padding-right: 10px;
      }
    }
  }
  .condition-list {
    position: absolute;
    margin-right: 10px;
    left: 331px;
    top: 20px;
    span {
      font-size: 12px;
      border-width: 1px;
      border-style: solid;
      padding: 0px 5px;
      height: 26px;
      display: block;
      box-sizing: border-box;
      cursor: pointer;
      max-width: 180px;
      overflow: hidden;
    }
    .condition-box {
      display: none;
      border-width: 1px;
      border-style: solid;
      position: absolute;
      width: 288px;
      left: 0;
      top: 26px;
      height: 160px;
      overflow: auto;
    }
    &:hover {
      .condition-box {
        display: block;
      }
    }
    .order-c-table {
      .thead,
      .tbody {
        display: flex;
        .th,
        .td {
          flex: 1;
          text-align: center;
          font-size: 12px;
        }
      }
      .tbody-box {
        height: 128px;

      }


    }
  }
  .block-expireTime {
    width: 290px;
    float: left;
    margin-top: 6px;
    position: relative;
    z-index: 9;
    .form-select .list {
      box-shadow: 0 4px 10px 0 rgba(0,0,0,0.2);
      padding: 15px 0;
      top: auto;
      bottom: 30px;
      border-width: 1px;
      border-style: solid;
    }
  }
  .category-select-box {
    width: 128px;
    margin-top: 16px;
  }
  .percentage {
    display: flex
    text-align: center;
    margin: 10px -5px 0 -5px;
    border-radius: 2px;
    span {
      flex: 1;
      height: 28px;
      line-height: 28px;
      border-width: 0;
      border-style: solid;
      cursor: pointer;
      font-size: 12px;
      user-select: none;
      margin: 0 5px;
      border-radius: 2px;
      border-width: 1px;
      border-style: solid;
    }
  }
}
