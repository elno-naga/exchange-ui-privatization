.market-slide-fade-enter-active {
  transition: all 0.3s ease-out;
}

.market-slide-fade-leave-active {
  transition: all 0.3s ease-out;
}

.market-slide-fade-enter, .market-slide-fade-leave-to {
  transform: translateY(-40px);
}