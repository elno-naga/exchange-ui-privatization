.currentSymbol {
  height: 70px;
  border-bottom-width: 0;
  border-bottom-style: solid;
  align-items: center;
  display: flex;
  position: relative;

  .operations-btn {
    position: relative;
    z-index: 12;
    padding: 0 16px;
    border-right-width: 1px;
    border-right-style: solid;
    height: 70px;

    .activePrice-item {
      display: none;
    }
  }

  .symbol-total {
    font-size: 18px;
    cursor: pointer;
    position: relative;
    user-select: none;
    line-height: 22px;
    height: 22px;
    margin-top: 24px;
    font-weight: 700;

    .hoverShow {
      display: none;
    }

    &:hover {
      .hoverHide {
        display: none;
      }

      .hoverShow {
        display: block;
      }
    }
  }

  .symbol-info {
    height: 34px;
    display: flex;
    justify-content: space-around;
    width: 88%;
    max-width: 900px;
    .activePrice-item {
      margin-top: -13px;
    }

    .info-item {
      font-size: 12px;
      text-align: left;
      position: relative;

      span {
        display: block;
      }

      .explain {
        border-bottom-style: dashed;
        border-bottom-width: 1px;
        display: inline-block;
        cursor: pointer;
      }

      .tit {
        padding-bottom: 2px;
      }

      .vla {
        margin-top: 6px;
      }

      .vla-l {
        display: inline;
      }

      .explain-text {
        width: 320px;
        padding: 15px 20px;
        position: absolute;
        left: 50%;
        margin-left: -180px;
        top: 22px;
        z-index: 20;
        text-align: left;
        line-height: 1.5;
        border-width: 0px;
        border-style: solid;
        border-radius: 4px;
        box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.2);
      }

      .explain-text-w {
        width: 168px;
        margin-left: -106px;
      }

      .triangle {
        position: absolute;
        top: -6px;
        left: 50%;
        margin-left: -5px;
        width: 10px;
        height: 10px;
        border-left-width: 0px;
        border-left-style: solid;
        border-top-width: 0px;
        border-top-style: solid;
        -webkit-transform: rotate(45deg);
        transform: rotate(45deg);
      }

      &:hover {
        .explain-text {
          display: block;
        }
      }
    }
  }

  .counter-and-set {
    flex: 1;
    display: none;
    -webkit-box-pack: end;
    -ms-flex-pack: end;
    justify-content: flex-end;
    padding-right: 16px;

    .hover-show {
      display: none;
    }

    .set-btn-icon {
      margin-left: 12px;
      cursor: pointer;

      &:hover {
        .hover-hide {
          display: none;
        }

        .hover-show {
          display: inline;
        }
      }
    }
  }

  .market-block {
    position: absolute;
    width: 355px;
    z-index: 100;
    top: 70px;
    left: 0;
  }

  .contract-desc {
    position: absolute;
    right: 18px;
    font-size: 12px;
    cursor: pointer;
    
    &:hover {
      opacity: 0.8;
    }
  }

  .set-button {
    flex: 1;
    display: flex;
    max-width: 130px;
    padding-left: 5px;

    span {
      display: inline-block;
      width: 56px;
      text-align: center;
      height: 24px;
      line-height: 24px;
      border-width: 1px;
      border-style: solid;
      margin: 0 0 0 5px;
      cursor: pointer;
      user-select: none;
      font-size: 12px;
    }
  }

  .activePrice {
    line-height: 32px;
    font-size: 20px;
    font-weight: 500;

    i {
      font-size: 12px;
      padding: 0 5px;
      border-radius: 3px;
      font-weight: normal;
      margin-left: 3px;
    }
  }

  .rose {
    text-align: left;
  }

  .market-shade {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    z-index: 10;
    opacity: 0.1;
  }

  .triangle-down {
    margin: -2px 0 0 4px;
    vertical-align: middle;
    padding: 0;
    display: inline-block;
    transition: all 0.3s ease-in-out;

    &.triangle-down-active {
      transform: rotate(180deg);
    }
  }
}

