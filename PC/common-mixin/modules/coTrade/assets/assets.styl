.sl-swap-assets {
  padding-bottom: 10px;
  position: relative;
  user-select: none;

  .assets-risk {
    position: absolute;
    width: 100%;
    left: 0px;
    bottom: 0px;
  }

  .block-header {
    height: 39px;
    line-height: 39px;
    padding: 0px 15px;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;

    &.title {
      border-top-width: 4px;
      border-top-style: solid;
    }

    .tab {
      display: inline-block;
      height: 48px;
      line-height: 48px;
      cursor: pointer;
      user-select: none;
      margin-right: 28px;
      font-size: 14px;

      em {
        font-size: 12px;
      }
    }

    .contract-data:hover {
      opacity: 0.8;
    }

    .assets-tit {
      display: flex;
      align-items: center;

      span {
        font-size: 14px;
      }

      i {
        font-size: 12px;
        margin-left: 3px;
      }
    }

    a {
      font-size: 12px;
      float: right;
      user-select: none;
    }
  }

  .assets-list {
    padding: 10px 0 0;

    li {
      font-size: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 16px;
      line-height: 30px;
      position: relative;

      .clole-style {
        background: #fff;
        width: 10px;
        height: 10px;
        float: left;
        margin-top: 1px;
        margin-right: 5px;
        border-radius: 2px;

        &.clole-style_1 {
          background: #91C7AE;
        }

        &.clole-style_2 {
          background: #62A0A8;
        }

        &.clole-style_3 {
          background: #5183BB;
        }
      }

      .bg {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        display: none;
      }

      &:hover {
        .bg {
          display: block;
        }
      }

      span {
        position: relative;
      }
    }

    .total-amount {
      // font-size: 14px;
      // padding: 10px 16px;
      // // border-bottom-width: 1px;
      // // border-bottom-style: solid;
      // margin-bottom: 5px;
    }

    .fee {
      padding: 10px;
      border-bottom-width: 1px;
      border-bottom-style: solid;
      margin-bottom: 5px;
    }
  }

  .operation-button {
    padding: 10px 11px 12px;
    display: flex;

    span {
      flex: 1;
      line-height: 32px;
      text-align: center;
      margin: 0 5px;
      border-radius: 2px;
      cursor: inherit;
    }
  }

  .risk {
    height: 62px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0px 15px;
    font-size: 12px;
    border-top-width: 1px;
    border-top-style: solid;

    h3 {
      font-size: 14px;
    }

    .limit {
      div {
        margin: 8px 0px;
      }
    }
  }

  .assetsChart {
    height: 200px;
    position: relative;
    padding-top: 10px;

    .total-rate {
      position: absolute;
      top: 90px;
      text-align: center;
      width: 100%;
      font-size: 12px;
      line-height: 18px;

      .text-il {
        width: 100px;
        margin: 0 auto;
      }

      .hint {
        left: -100px;
        top: auto;
        bottom: 20px;
        width: 293px;
        padding: 5PX;
        background-color: #7B828E;
        color: #fff;
        .triangle {
          position: absolute;
          top: -6px;
          left: 50%;
          margin-left: -5px;
          width: 10px;
          height: 10px;
          border-left-width: 1px;
          border-left-style: solid;
          border-top-width: 1px;
          border-top-style: solid;
          -webkit-transform: rotate(45deg);
          transform: rotate(45deg);
        }
      }
    }
  }

  .futures-info-list {
    padding: 10px 0;

    .info-item {
      height: 32px;
      width: 100%;
      border-bottom-width: 0;
      border-bottom-style: solid;
      font-size: 12px;
      line-height: 32px;
      padding: 4px 15px;
      box-sizing: border-box;

      span {
        display: inline-block;
        width: 50%;

        &.td {
          text-align: right;
        }
      }
    }
  }

  .hint-father {
    position: relative;

    >a {
      cursor: pointer;
      border-bottom-style: dashed;
      border-bottom-width: 1px;
      position: relative;
    }
  }

  .hint {
    width: 200px;
    padding: 8px 12px 4px 12px;
    position: absolute;
    left: 0px;
    bottom: 35px;
    z-index: 10;
    border-radius: 4px;
    box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.2);
    line-height: 1.5;
    .triangle {
      position: absolute;
      bottom: -12px;
      left: 10%;
      margin-left: -5px;
    }
  }
  .unRealized-tip-box {
    width: 280px;
    position: absolute;
    left: 0px;
    bottom: 0px;
    height: 80px;
    padding-bottom: 30px;
    .hint {
      width: 280px;
    }
    .s-title {
      font-size: 14px;
      margin-bottom: 10px;
    }
    .slect-redio {
      cursor: pointer;
      span {
        margin: 0 10px 0 0;
        display: inline-block;
        line-height: 18px;
        .common-redio {
          float: left;
          margin: 1px 6px 0 0;
        }
      }
      p {
        padding-bottom: 10px;
      }
    }
    .loadingIng {
      span {
        cursor: wait !important;
      }
    }
  }

  .tip-show-enter-active {
    transition: all 0.2s 0.5s ease;
  }

  .tip-show-leave-active {
    transition: all 0.2s cubic-bezier(1, 0.5, 0.8, 1);
  }

  .tip-show-enter, .tip-show-leave-to {
    transform: translateY(10px);
    opacity: 0;
  }
}
