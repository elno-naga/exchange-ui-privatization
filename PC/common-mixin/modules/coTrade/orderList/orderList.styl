.order-list-box {
  .common-tabel-content {
    min-width: 900px !important;
  }

  .stop-order-info-dialog .closeBtnClass {
    display: none;
  }

  .tab-box {
    user-select: none;
    padding-left: 16px;
    .commonTab-tab {
      height: 39px;
    }
    .tab-item {
      font-size: 14px;
      margin-right: 45px;
      display: inline-block;
      cursor: pointer;
      height: 37px;

      &.selected {
        border-bottom-style: solid;
        border-bottom-width: 2px;
      }
    }

    .common-button {
      float: right;
      margin-top: 6px;
      font-size: 12px;
    }

    .is-show-active {
      float: right;
      font-size: 12px;
      line-height: 44px;
      margin-right: 15px;
      position: relative;
      z-index: 3;

      .switchWrap {
        display: inline-block;
        margin-right: 8px;
        margin-top: 12px;
        float: left;
      }

      span.txt {
        display: inline-block;
        float: right;
      }
    }
  }
  .tab-box-en_US {
    .commonTab-tab {
      li {
        margin-right: 26px;
      }
    }
  }

  .sub-tab-box {
    height: 34px;
    border-bottom-width: 1px;
    border-bottom-style: solid;
    padding: 0 20px;

    .tab-item {
      font-size: 12px;
      display: inline-block;
      cursor: pointer;
      height: 24px;
      line-height: 24px;
      padding: 0 20px;
      margin-top: 5px;
      user-select: none;
    }
  }

  .order-conent {
    position: relative;
    .c-table-box {
      position: relative;
    }
    .cancel-all {
      position: absolute;
      z-index: 1;
      font-size: 12px;
      top: 2px;
      right: 10px;
    }
  }


  .not-login {
    position: absolute;
    top: 44%;
    width: 100%;
    text-align: center;
    margin-top: 140px;
    span {
      cursor: pointer;
    }
  }
  .table-head {
    margin-top: 14px;
    .th {
      min-width: fit-content;
    }

    th {
      text-align: left;
      box-sizing: border-box;

      &:first-child {
        padding-left: 20px;
        text-align: left;
      }

      &:last-child {
        padding-right: 20px;
        text-align: right;
      }

      &.opera {
        opacity: 0;
      }
    }
  }

  .table-body .table-body-bar {
    padding: 0;
    min-height: 0;
    td {
      position: relative;
      text-align: left;

      &:first-child {
        padding-left: 20px;
        text-align: left;
        font-size: 14px;
      }

      &:last-child {
        padding-right: 20px;
        text-align: right;
      }

      .futurs-name {
        min-width: 200px;

        span {
          margin-right: 5px;
        }

        .sideBg {
          position: absolute;
          width: 2px;
          height: 12px;
          top: 14px;
          left: 16px;
        }

        .slide-type {
          font-size: 12px;
        }
      }
    }

    .cancel_cause {
      min-width: 80px;

      .cancel_cause_text {
        display: none;
        position: absolute;
        width: 100px;
        padding: 10px;
        right: 20px;
        top: -10px;
        z-index: 10;
        box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.2);
        line-height: 1.5;
        word-break: break-all;
      }

      .cancel_cause-btn {
        position: relative;
      }

      &:hover {
        .cancel_cause_text {
          display: block;
        }
      }
      &.cancel_cause_right {
        .cancel_cause_text {
          left: 20px;
        }
      }
    }

  }

  .stop-order-info {
    margin-bottom: 20px;

    .item {
      padding: 10px 20px;

      .line {
        padding: 10px 0 10px 0;

        .td {
          display: inline-block;
          width: 50%;

          .tit {
            font-size: 14px;
            margin-bottom: 10px;
          }

          .status {
            font-size: 16px;
          }
        }

        .right-text {
          text-align: right;
        }
      }
    }
  }
  .all-close-btn {
    float: right;
    margin: 0 20px 0 15px;
    line-height: 40px;
    font-size: 12px;
    position: relative;
    z-index: 3;
    cursor: pointer;
  }
  .copywriter {
    line-height: 22px;
  }
}

.common-tabel-content {
  .table-body {
    min-height: 180px;
    .no-data {
      padding-bottom: 0;
    }
  }
}
.promptTextBox {
  max-width: 320px;
  padding: 8px 12px 4px;
  position: fixed;
  top: 900px;
  z-index: 10;
  line-height: 18px;
  text-align: left;
  border-radius: 4px;
  font-size: 12px;
  &.promptText-hide {
    z-index: -1;
  }
  .tip-arrow {
    position: absolute;
    left: 50%;
    margin-left: -6px;
    bottom: -12px;
  }
}