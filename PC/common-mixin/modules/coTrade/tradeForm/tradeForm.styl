.co-trade-box {
  font-size: 12px;
  padding: 0;
  .title-block {
    padding: 13px 15px 0 15px
    font-size: 14px;
    .tab {
      display: inline-block;
      border-bottom-style: solid;
      border-bottom-width: 0px;
      height: 38px;
      cursor: pointer;
      user-select: none;
      margin-right: 28px;
      font-size: 14px;
      &.main-1-bd {
        border-bottom-style: solid;
        border-bottom-width: 2px;
      }
    }
    &.no-border {
      border: none;
      margin-top: 27px;
    }
    .show-dialog-btn {
      height: 24px;
      width: 78px;
      display: inline-block;
      line-height: 24px;
      font-size: 12px;
      box-sizing: border-box;
      text-align: center;
      border-radius: 3px;
      cursor: pointer;
      &.show-dialog-btn-left {
        border-radius 2px 0 0 2px;
      }
      &.show-dialog-btn-right {
        border-radius 0 2px 2px 0;
      }
    }
  }
  .counter-and-set {
    flex: 1;
    -webkit-box-pack: end;
    -ms-flex-pack: end;
    justify-content: flex-end;
    float: right;
    position relative;
    &:hover {
      z-index: 15;
    }
    .hover-show {
      display: none;
    }
    .set-btn-icon {
      margin-left: 12px;
      cursor: pointer;
      &:hover {
        .hover-hide {
          display: none;
        }
        .hover-show {
          display: inline;
        }
      }
    }
  }
  .trade-form {
    padding: 15px;
    .category-select-box {
      width: 100%;
      display: flex;
      border-radius: 2px;
      margin-bottom: 12px;
      position: relative;
      .tab {
        flex: 1;
        height: 40px;
        line-height: 40px;
        text-align: center;
        cursor: pointer;
        user-select: none;
        font-size: 14px;
        position: relative;
      }
      .tab-active-bg {
        position: absolute;
        width: 50%;
        height: 100%;
        transition: all 0.5s;
        left: 50%;
        border-radius: 2px;
      }
    }
    .category-tab-box {
      .commonTab-tab {
        color : #fff;
        li {
          &:nth-child(3) {
            margin: 0;
          }
        }
      }
    }
    .isMarket-form-input {
      position: relative;
    }
    .convert {
      height: 26px;
      line-height: 26px;
      padding: 0 15px;
      position: absolute;
      border-radius: 2px;
      top: -34px;
      right: 0;
      z-index: 90;
      .arrow {
        display: inline-block;
        width: 8px;
        height: 8px;
        bottom: -4px;
        position: absolute;
        transform: rotate(45deg);
        right: 40%;
      }
    }
    .openable,
    .hold-position,
    .available {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 12px;
      >div {
        label {
          margin-right: 5px;
          user-select: none;
        }
        span {
          user-select: none;
        }
      }
    }
    .available {
      .right {
        width: 30px;
        display: block;
        text-align: center;
        cursor: pointer;
        .icon {
          vertical-align: middle;
        }
      }
    }
    .openable {
      margin-top: 16px;
    }
    // 按钮
    .submit-button {
      margin-top: 12px;
      height: 40px;
      .common-button {
        float: left;
        transition: none;
      }
      // 按钮
      .buyBtn {
        margin-right: 8px;
      }
    }
    .percentage {
      display: flex
      text-align: center;
      margin: 4px -2px 0 -2px;
      border-radius: 2px;
      span {
        flex: 1;
        height: 24px;
        line-height: 24px;
        cursor: pointer;
        user-select: none;
        margin: 0 2px;
        border-radius 2px;
        border-width: 1px;
        border-style: solid;
      }
    }
    .tip-text {
      width: 227px;
      padding:12px 16px;
      position: absolute;
      left: -10px;
      bottom: 26px;
      z-index: 10;
      box-shadow: 0px 0px 5px rgba(0,0,0,0.2);
      line-height: 1.5;
      border-width: 0;
      border-style: solid;
      border-radius: 5px;
      .triangle {
        position: absolute;
        bottom: -5px;
        left: 10%;
        margin-left: -5px;
        width: 10px;
        height: 10px;
        border-right-width: 0;
        border-right-style: solid;
        border-bottom-width: 0;
        border-bottom-style: solid;
        -webkit-transform: rotate(45deg);
        transform: rotate(45deg);
      }
    }
    .rt-label-zjc {
      right: 0px;
      left auto;
      .triangle {
        right: 6%;
        left: auto;
      }
    }
    .rt-label {
      border-bottom-style: dashed;
      border-bottom-width: 1px;
      position: relative;
    }
    .option {
      // display: flex;
      margin-top: 14px;
      span {
        user-select: none;
        position: relative;
        .rt-label {
          vertical-align: text-top;
          margin-left:  5px;
        }
      }
      .common-checkout {
        float left
      }
      .checkBoxlabel {
        display inline-block;
        margin-left: 5px;
        user-select none;
        cursor: pointer;
        line-height: 16px;
      }
      .stopCheckBox {
        display block;
        margin-top: 10px;
      }
      .rt-label0 {
        .tip-text {
          left: -70px
        }
      }
      .rt-label1 {
        .tip-text {
          left: -150px
        }
      }
      .rt-label2 {
        .tip-text {
          left: -200px
        }
      }
      .zhiJianCang {
        float right;
      }
    }
    .stop-order-price {
      overflow: hidden;
      clear: both;
      .select-price {
        margin-top: 14px;
        input {
          // width: auto;
        }
      }

    }
    .form-error {
      padding-top: 8px;
      margin-bottom: 10px;
      clear: both;
    }
    .expireTime {
      .list {
        text-align: right;
      }
    }
    .select-order-type {
      position: relative;
      display: inline-block;
      cursor pointer;

      &.disabled-order-type {
        opacity: 0.4;
        cursor: no-drop;
      }
      .tip-text {
        left: 0;
      }
      .orde-type-ptions {
        padding-top: 12px;
        box-sizing: border-box;
        overflow: hidden;
        width: 100%;
        .option-item {
          height: 24px;
          line-height: 24px;
          cursor: pointer;
          margin-bottom: 1px;
          text-align: right;
          display: inline-block;
          user-select: none;
          margin-right: 26px;
          .redioText {
            margin-left: 5px;
            border-bottom-width: 1px;
            border-bottom-style: dashed;
            cursor: pointer;
          }
          .tip-text {
            bottom: 36px;
            text-align: left;
          }
          .tip-text2 {
            .triangle {
              left: auto;
              right: 21%;
            }
          }
          .tip-text1 {
            .triangle {
              left: 51%;
            }
          }
          .tip-text0 {
            .triangle {
              left: 18%;
            }
          }
        }
      }
      .ac-type {
        vertical-align: text-top;
        margin-left: 5px;
        user-select: none;
        .tit {
          border-bottom-style: dashed;
          border-bottom-width: 1px;
        }
        .h-show {
          display: none;
        }
        .h-hide {
          display: inline-block;
        }
        &:hover {
          .h-show {
            display: inline-block;
          }
          .h-hide {
            display: none;
          }
          .tip-text {
            display: block;
          }
        }
      }

    }
    .triangle-down {
      width: 0;
      height: 0;
      border-left: 6px solid transparent !important;
      border-right: 6px solid transparent !important;
      border-top-width: 5px;
      border-top-style: solid;
      margin: 5px 0 0 4px;
      vertical-align: top;
      padding: 8px 0 0;
      display: inline-block;
      cursor: pointer;
      transition: all .3s ease-in-out;
      &.triangle-down-active{
           transform: rotate(180deg);
           top:-7px;
        }
    }
  }
  .mask-div {
    position: fixed;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 10;
  }
  // 展开效果
  .developIn-enter-active {
    animation: developIn 0.3s;
  }
  .developIn-leave-active {
    animation: developIn 0.3s reverse;
  }
  @keyframes developIn {
    0% {
      height 0
      opacity 1
      padding-top: 0;
    }
    100% {
      opacity 1
      height 37px
      padding-top: 12px;
    }
  }

  // 展开效果
  .developInTwo-enter-active {
    animation: developInTwo 0.3s;
  }
  .developInTwo-leave-active {
    animation: developInTwo 0.3s reverse;
  }
  @keyframes developInTwo {
    0% {
      height 0
      opacity 1
    }
    100% {
      opacity 1
      height 92px
    }
  }
  .tip-show-enter-active {
    transition: all .2s .5s ease;
  }
  .tip-show-leave-active {
    transition: all .2s cubic-bezier(1.0, 0.5, 0.8, 1.0);
  }
  .tip-show-enter, .tip-show-leave-to {
    transform: translateY(10px);
    opacity: 0;
  }
}
.input-tips-enter-active {
  transition: all .5s;
}
.input-tips-leave-active {
  transition: all .5s;
}
.input-tips-enter, .input-tips-leave-to
/* .slide-fade-leave-active for below version 2.1.8 */ {
  transform: translateY(-5px);
  opacity: 0;
}
