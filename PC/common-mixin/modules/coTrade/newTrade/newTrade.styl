.coNewTrade-container {
  .block-header {
    height: 39px !important;
    line-height: 39px !important;
    padding: 0 15px !important;
    font-size: 14px !important;
  }

  .thead {
    height: 24px;
    line-height: 24px;
    padding: 0 15px 0 0;
    font-size: 12px;

    span {
      display: inline-block;
      white-space: nowrap;
    }
  }

  .tbody {
    padding: 0px 0 3px;
    font-size: 12px;
    height: 68px;
    box-sizing: border-box;

    .symbol-item {
      line-height: 17px;
      cursor: pointer;
      position: relative;

      .bg {
        display: none;
      }

      .rose {
        position: absolute;
        top: 1px;
        left: 10px;
        font-size: 12px;
      }

      &:hover {
        .bg {
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
        }
      }

      &.change-item {
        .change {
          position: absolute;
          animation: 2s opacityZ 0s 1;
          top: 2px;
          left: 0;
          height: 80%;
          width: 100%;
          opacity: 0;
        }
      }
    }
  }

  .thead, .tbody {
    span {
      display: inline-block;
      text-align: right;
      position: relative;

      .icon {
        display: inline-block;
        vertical-align: middle;
        height: 15px;
        background: #f00;
        float: left;
        margin: 8px 5px 0 0;
      }

      .hover_show {
        display: none;
      }

      &:hover {
        .hover_show {
          display: block;
        }

        .hover_hide {
          display: none;
        }
      }

      &:first-child, &.td-symbol {
        text-align: left;
        box-sizing: border-box;
        padding-left: 15px;
      }
    }
  }

  .tr-bg {
    position: absolute;
    height: 20px;
    top: 0;
    left: 0;
    z-index: 1;
    opacity: 0.16;
    padding: 0;
    width: 10%;
    transiton: width 0.5s ease;
    -webkit-transition: width 0.5s ease;
  }

  @keyframes opacityZ {
    0% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes opacityZ {
    0% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes opacityZ {
    0% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  @media screen and (min-width: 1660px) {
    .tbody {
      height: 143px;
    }
  }
}
