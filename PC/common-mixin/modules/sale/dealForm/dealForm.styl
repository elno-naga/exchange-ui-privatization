.dealform-center{
    font-size:12px;
    box-sizing: border-box;
    transition: height 0.3s;
}
.dealformCenter{
    margin:0 0 8px;
    display:flex;
    justify-content:space-between;
}
.dealform-nav{
    margin:0 0 24px;
}
.loginOrReg{
    margin-top 20px;
}
.dealFormInput{
    display:flex;
}
.dealFormInput-up{
    flex-direction:column;
}

.dealFormInput-down{
    flex-direction:column-reverse;
}
.dealFormInput-priceVomMargin{
    margin:0 4px;
}
.loginOrReg {
    width: 100%;
    height: 40px;
    text-align: center;
    line-height: 40px;
    font-size: 14px;
    font-weight: 500;
    border-radius: 2px;
    margin-top: 32px;
    span  {
        cursor: pointer;
    }
}
.marginTop24{
    margin-top:24px;
}
    .fontSize14{
        font-size:14px;
    }
