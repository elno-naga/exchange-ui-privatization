.saleDownload {
  padding: 24px 32px;

  .setting-title {
    font-size: 20px;
    line-height: 23px;
    margin-bottom: 32px;
    font-weight:500;
  }

  h5 {
    font-size: 12px;
    line-height: 14px;
    margin-bottom: 16px;
  }

  .saleDownload-center{
      .form-item{
        margin:0 0 32px;
        font-family: PingFangSC-Medium;
        & > label{
          font-size:12px;
          display:inline-block;
        }
        .form-item-center{
          display:flex;
          font-size:14px;
        }
      }
    .flex-lengthways-center{
      display:flex;
      align-items:center;
    }
    .flex-wrap{
      flex-wrap:wrap;
    }
    .marginLeft8px{
      margin-left:8px;
    }
    .marginLeft4px{
      margin-left:4px;
    }
    .marginLeft40px{
      margin-left:40px;
    }
    .marginTop16px{
      margin-top:16px;
    }
    .marginBottom16px{
      margin-bottom:16px;
    }
    .width33{
      width:33.33%;
    }
    .warningText{
      font-size:12px;
      line-height:18px;
      padding:8px 12px;
      background-color:rgba(233, 169, 42, 0.10);
      margin:32px 0;
      border-radius: 4px;
    }
  }
  .spanPointer{
    cursor:pointer;
  }
}
