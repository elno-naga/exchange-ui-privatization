.trade-table-list-container {
  .thead {
    height 29px
    line-height 29px
    font-size 12px
    padding 0 16px

    span {
      display inline-block
      white-space nowrap
    }
  }

  .tbody {
    // padding 5px 0 5px
    position relative
    font-size 12px
    transiton height 0.5s ease
    width 100%
    -webkit-transition height 0.5s ease

    &.no-padding {
      padding 0
    }

    .symbol-item {
      padding 0 16px
      line-height 20px;
      cursor pointer
      position relative

      .bg {
        display none
      }

      &:hover {
        .bg {
          display block
          position absolute
          top 0
          left 0
          height 100%
          width 100%
        }
      }

      &.change-item {
        .change {
          position absolute
          animation 1s opacity2 0s 1
          top 0px
          left 6px
          height 100%
          right 0
          opacity 0
        }
      }
    }
    .active-price-point {
      display: inline-block;
      width: 4px;
      height: 4px;
      border-radius: 100px;
      vertical-align: 2px;
      margin-left: 3px;
    }
  }

  @keyframes opacity2 {
    0% {
      opacity 1
    }

    100% {
      opacity 0
    }
  }

  @keyframes opacity2 {
    0% {
      opacity 1
    }

    100% {
      opacity 0
    }
  }

  @keyframes opacity2 {
    0% {
      opacity 1
    }

    100% {
      opacity 0
    }
  }

  .asksOPtion {
    position absolute
    bottom 0
  }

  .thead, .tbody {
    .symbol-item {
      line-height 16px
    }
    span {
      display inline-block
      text-align right
      position relative
      z-index 9

      .icon {
        display inline-block
        vertical-align middle
        height 15px
        float left
        margin 8px 5px 0 0
      }

      .hover_show {
        display none
      }

      &:hover {
        .hover_show {
          display inline-block
        }

        .hover_hide {
          display none
        }
      }

      &.td-symbol, &.td-symbol0 {
        text-align left
        // padding-left 20px
      }
    }
  }

  .tr-bg {
    position absolute
    height 100%
    top 0
    left 0
    z-index 1
    padding 0
    width 10%
    transiton width 0.5s ease
    -webkit-transition width 0.5s ease
  }
  &.buy {
    .thead {
      display: none;
    }
  }
}
.newTrade-depth-block .trade-table-list-container .tr-bg {
  left: auto;
  right: 0;
}

// 国际版
.Int-trade {
  .trade-table-list-container {
    .tbody {
      padding: 5px 0;
      .symbol-item {
        line-height: 16px;
      }
      .tr-bg {
        height: 16px
      }
    }
    .asksOPtion {
      position initial
    }

    .tbodyBar {
      overflow initial !important
    }
  }
}