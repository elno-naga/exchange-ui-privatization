.newTrade-content .ex-canter-echart-box {
  z-index 9
  width 100%
  height 295px
  position relative

  .kline-bg {
    position absolute
    bottom 130px
    left 15px
    z-index 999

    .kline-img {
      max-width calc(100% - 85px)
    }
  }

  .mmd-loading-circle-right, .mmd-loading-circle-left {
    // border-color: rgba(19, 82, 245, 1);
  }

  .inline {
    position absolute
    top 30px
    height 1px
    z-index 9
    width 100%
  }
  .top-menu_container {
    position: absolute;
    left: 0px;
    top: 0;
    right: 0;
    height: 30px;
    z-index: 100;
  }

  .top-menu {
    line-height 30px
    font-size 12px
    padding 0
    position absolute
    left 0
    right 210px
    transition all 0.5s ease
    z-index 9
    &.lefts {
      left :0
    }
    .top-menu-bar {
      position relative
      // overflow hidden
      height 30px
      width 100%

      .hover_hide {
        display block
      }

      .hover_show {
        display none
      }

      .slide-btn {
        position absolute
        top 0px
        padding 8px 0
        z-index 9
        cursor pointer
        display none

        &:hover {
          .hover_show {
            display block
          }

          .hover_hide {
            display none
          }
        }
      }

      .slide-btn-cur {
        display block
      }

      .icon-left {
        left 0
        padding-right 5px
      }

      .icon-right {
        right 0
        padding-left 5px
      }
    }

    .top-menu-box {
      height 30px
      // overflow hidden
      width max-content
      white-space nowrap
      position absolute
      top 0
      left 0
      transiton left 0.2s linear
      -webkit-transition left 0.2s linear
      display: flex;
      align-items: center;
      .newTrade-select {
        margin-left: 5px;
        .s-selectd {
          border: 0;
        }
        .select-options-box {
          width: 205px;
        }
      }
      .time-line_list {
        padding: 16px;
        display: flex;
        flex-wrap: nowrap;
        border-radius: 2px;
        box-sizing: border-box;
        width: 205px;
        .time-line_item {
          width: 53px;
          height: 23px;
          line-height: 23px;
          text-align: center;
          border-radius: 2px;
          margin-right: 12px;
          &:last-child {
            margin-right: 0;
          }
        }
      }
    }
    .header_tools_btn {
      float: left;
      position: relative;
      margin-left: 15px;
      cursor: pointer
      .chartType-list {
        position: absolute;
        top: 31px;
        left: -40px;
        .chartType-list-bar {
          width: 180px;
          border-radius: 2px;
          height: auto;
          overflow: hidden;
          position relative;
          padding: 5px 0;
        }
        .type-item {
          padding: 0 16px;
          line-height: 40px;
          height: 44px;
          display: block;
          box-sizing border-box;
          .hover-show {
            display none;
          }
          .hover-hide {
            display: inline-block;
          }
          &:hover {
            .hover-show {
              display: inline-block;
            }
            .hover-hide {
              display: none;
            }
          }
        }
      }
      .hover-show {
        display none;
      }
      &:hover {
        .chartType-list {
          display: block;
        }
        .hover-show {
          display: inline-block;
        }
        .hover-hide {
          display: none;
        }
      }
      .icon {
        vertical-align sub;
      }
    }


    .full-btn {
      // border-left-width 1px
      // border-right-width 1px
      // border-left-style solid
      // border-right-style solid
      // padding 0 14px
      .hover_show {
        display none
      }

      &:hover {
        .hover_hide {
          display none
        }

        .hover_show {
          display inline-block
        }
      }
    }

    &.hide {
      opacity 0
      z-index 1
    }
  }
  .time-line {
    display inline-block
    padding 0 10px
    cursor pointer
    user-select none
    line-height 23px
    border-radius: 2px;

    .hoverShow {
      display none
    }

    &:hover {
      .hoverHide {
        display none
      }

      .hoverShow {
        display inline-block
      }
    }
  }
  .full-btn {
    position: relative;
    line-height: 1;
    padding 0 10px
    cursor pointer
    .hover_show {
      display none
    }

    &:hover {
      .hover_hide {
        display none
      }

      .hover_show {
        display inline-block
      }
    }
  }
  .mask-bg {
    top: 0px;
    bottom: 0;
    position: absolute;
    inset-inline-start: 0;
    inset-inline-end: 0;
    z-index: 999;
  }
  .slide {
    position absolute
    top:30px;
    left 0
    width 100%
    opacity 0
    transition all 0.5s ease
    overflow hidden
    height:calc(100% - 30px);
    z-index 2

    &.selected {
      transform translateX(0%)
      opacity 1
      z-index 3
    }
  }

  .top-tab {
    position absolute
    right 0
    height 30px
    line-height 30px
    text-align right
    z-index 101
    display: flex;
    align-items: center;

    .switch-chart-type {
      margin-right 8px
      cursor pointer
      font-size: 12px
      height: 23px;
      line-height: 23px;
      padding: 0 12px;
      border-radius: 2px;
    }
  }

  .tv_chart_container {
    height 100%
    width 100%
  }

  .loading-indicator {
    background none
  }

  .coverKlineBox {
    position absolute
    top 30px
    left 0
    right 0
    bottom 0
    z-index 99
  }

  // 页面动画
  .fade-enter-active, .fade-leave-active {
    transition opacity 0.8s
  }

  .fade-enter, .fade-leave-to {
    opacity 0
  }

  .loading {
    position absolute
    top 50%
    left 50%
    z-index 999
    margin -25px 0 0 -25px
  }
}

.canter-echart-full {
  object-fit contain
  position fixed !important
  top 0px !important
  right 0px !important
  bottom 0px !important
  left 0px !important
  box-sizing border-box !important
  min-width 0px !important
  max-width none !important
  min-height 0px !important
  max-height none !important
  width 100% !important
  height 100% !important
  transform none !important
  margin 0px !important
}
@media (max-width: 460px){
  .ex-canter-echart-box .top-menu{
    left:75px;
  }
}
