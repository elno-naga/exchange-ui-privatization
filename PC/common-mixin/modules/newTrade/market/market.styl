.newTrade-market-index-container {
  &.newTrade-market {
    font-size 12px
    width 100%
    height: 525px;
    margin-bottom: 1px;
    border-radius: 2px;
    overflow: hidden;

    .market-header {
      position relative
      height 97px;
      padding 16px 16px 0 16px
      border-bottom-width 1px
      border-bottom-style solid
      box-sizing: border-box;
    }

    .search {
      position relative
      height:auto;
      margin-bottom:12px;

      input::-webkit-input-placeholder {
        color #6a6a6a
      }
      .search-input {
        width: 100%;
      }
    }

    .kg {
      position absolute
      top 10px
      right 15px
      font-size 16px
    }

    .market-title-bar {
      position relative
      width 100%
      // overflow hidden
      height 34px

      .newTrade-select {
        top: 5px;

      }

      .hover_hide {
        display block
      }

      .hover_show {
        display none
      }

      .slide-btn {
        position absolute
        top 10px
        z-index 9
        cursor pointer
        display none

        &:hover {
          .hover_show {
            display block
          }

          .hover_hide {
            display none
          }
        }
      }

    }

    .market-title {
      display flex
      height 34px
      // overflow hidden
      width max-content
      white-space nowrap
      position relative

      li.market-item {
        font-size 12px
        line-height 34px
        cursor pointer
        margin-right 27px
        border-bottom-width 1px
        border-bottom-style solid
        border-bottom-color: transparent
        .newTrade-select {
          top: 2px;
        }
      }
      .underline {
        position: absolute;
        bottom: -1px;
        width: 24px;
        height: 4px;
        left: 0;
        transition: all 0.3s;
      }
      &.disabled .market-item {
        opacity 0.3;
      }
    }

    .market-symbol {
      .thead {
        height 29px
        line-height 30px
        //border-bottom-width 1px
        //border-bottom-style solid
        padding 0 15px
        display: flex;

        span {
          // display inline-block
          height 30px
          overflow hidden
        }
        .td-symbol {
          padding-left: 0;
        }
      }

      .tbody {
        padding 0 0 5px 0
        // height 855px
        height 417px

        .block-title {
          height 29px
          line-height 29px
          padding-left 15px
          font-size 12px
          //border-bottom-style solid
          //border-bottom-width 1px
        }

        .symbol-item {
          white-space:nowrap;
          padding 0 15px
          line-height 31px
          cursor pointer
          position relative
          display: flex;

          .multiple {
            border-width: 1px;
            border-style: solid;
            padding: 0 3px;
            line-height: 1;
            font-size: 12px;
            margin-left: 12px;
            border-radius: 2px;
          }

          .bg {
            display none
          }

          &:hover {
            .bg {
              display block
              position absolute
              top 0
              left 0
              height 100%
              width 100%
            }
          }

          span {
            // display inline-block
            line-height 31px
            position relative

            .iconMy {
              margin-right: 8px;

              svg {
                margin 0
              }
            }

            .hover_show {
              display none
            }

            &:hover {
              .hover_show {
                display inline-block
              }

              .hover_hide {
                display none
              }
            }
          }
        }
      }

      .td-symbol {
        display flex
        align-items center
        width 110px
        position relative
        cursor pointer
      }

      .td-price {
        display flex
        align-items center
        width 100px
        user-select none
        justify-content flex-end
        cursor pointer
      }

      .td-rose {
        display flex
        align-items center
        user-select none
        width 80px
        justify-content flex-end
        cursor pointer
      }

      .sorte {
        width 14px
        height 14px
        margin-left 1px

        .icon {
          vertical-align top
          margin-top: 2px;
        }

        i {
          display inline-block
          width 8px
          height 8px
          position absolute
          left 0
          line-height 6px
          overflow hidden

          em {
            position absolute
            top 0
            right 0
            transition all 0.3s ease-in-out
            display block
            border-width 4px
            border-style solid dashed dashed
            border-color #828ea1 transparent transparent
            font-size 0
            line-height 0
            transform rotate(180deg)
          }

          &.icon-triangle-up {
            bottom 0

            em {
              transform rotate(0deg)
            }
          }
        }

        &.selected {
          .cur {
            em {
              border-color #EDF4F8 transparent transparent
            }
          }
        }
      }
    }

    .table-head {
      padding 0 15px
      overflow hidden
    }

    .table-body {
      padding 5px 0

      .table-body-bar {
        padding 0
      }

      tr {
        border none
        cursor pointer

        .store {
          margin 0 7px 0 0
        }

        td {
          overflow hidden
          padding 0 15px

          &:nth-child(2) {
            padding 0 10px 0 0
          }
        }
      }
    }
  }
  &.lever-market {
    .market-symbol {
      .tbody {
        // height 855px
        height: 390px
      }
    }
  }
}

.not-data {
  text-align center
  padding-top 80px

  p {
    margin-top 5px
  }

  .icon {
    font-size 36px
  }
}

.left-shrinks {
  left-block-shrink()
}

// 国际化
.Int {
  .trade-market-index-container {
    &.trade-market, .market-symbol {
      height 100%
    }

    &.trade-market .market-symbol .tbody {
      height calc(100% - 100px)
    }
  }
}
