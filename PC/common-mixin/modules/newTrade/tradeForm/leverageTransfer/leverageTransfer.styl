.leverageTransfer-container {
  .transfer-loadingBox {
    height 261px
    width 400px
    position relative

    .transfer-loading {
      position absolute
      left 45%
      top 45%
      transform translate3d(-50%, -50%, -50%)
    }
  }

  .transfer-box {
    box-sizing border-box
    padding-top 10px
    padding-bottom 16px

    .transfer-mess {
      width 400px
      height 70px
      box-sizing border-box
      padding-left 15px

      .even {
        float left
        height 70px
        line-height 70px
      }

      .key {
        margin-left 8px
        margin-right 28px
        cursor pointer
        font-size 14px
        user-select none
      }
    }

    .transfer-content {
      width 400px
      height 70px
      margin-bottom 23px
      user-select none
      margin-top 2px

      li {
        float left
      }

      .transfer-page {
        width 160px
        padding-left 15px
        height 70px
      }

      .transfer-page-side {
        font-size 12px
        line-height 16px
        margin-top 13px
      }

      .transfer-page-name {
        margin-top 5px
        font-size 14px
      }

      .transfer-icon {
        width 50px
        height 70px
        line-height 85px
        text-align center

        .icon {
          cursor pointer
        }
      }
    }
  }
}
.newTradeModel-margin .new-leverageTransfer-container {
  .transfer-box {
    display: flex;
    align-items: center;
    position: relative;
    .transfer-reverse {
      margin-right: 28px;
      cursor pointer
      position: relative;
      width: 32px;
      height: 150px;
      .icon {
        width: 0.5em;
        font-size: 176px;
        position: absolute;
        top: -10px;
        left: -28px;
      }
    }
    .transfer-account {
      width: 340px;
      display: flex;
      flex-direction: column;
    }
    .transfer-fixed {
      width: 340px;
      height: 40px;
      margin-top: 8px;
      margin-bottom: 16px;
      font-size: 14px;
    }
    .transfer-from, .transfer-to {
      width: 340px;
      display: flex;
      position: absolute;
      left: 60px;
      transition: all 0.5s;
      .transfer-name {
        flex: 1;
        padding-left: 15px;
        box-sizing: border-box;
        height: 40px;
        line-height: 40px;
      }
      .transfer-symbol {
        width: 136px;
        height: 40px;
        line-height: 40px;
        padding-left: 15px;
        margin-left: 10px;
        box-sizing: border-box;
      }
    }
    .transfer-from {
      top: 20px;
      &.reverse {
        top: 96px;
      }
    }
    .transfer-to {
      top: 96px;
      &.reverse {
        top: 20px;
      }
    }
  }
  .transfer-form {
    .coin-title {
      font-size: 12px;
    }
    .common-select {
      margin-bottom: 24px;
    }
    .delete-icon {
      display: inline-block;
      line-height: 30px;
      vertical-align: middle;
      img {
        width: 13px;
        vertical-align: middle;
      }
    }
  }
}