.newTrade-depth-block.depath-index-container {
  width 320px
  margin-right: 5px;
  flex-shrink: 0;
  .depth {
    width 100%
    height 850px
    position relative
    overflow hidden
    margin-right 5px
    &.gridFix {
      height: 937px;
    }
    .block-content {
      position: static;
      top: 0;
    }
  }

  .block-header {
    height 63px!important
    padding 8px 8px 8px 16px
    font-size 14px
    border-radius 2px
    box-sizing: border-box
    line-height 1
    border 0
    h4 {
      margin-bottom 11px
      font-size: 14px;
    }
    .depth-viewSetting {
      display flex
      align-items center
      justify-content space-between
      .accuracy {
        .s-selectd {
          svg {
            right: 3px;
            bottom: 5px;
          }
        }
      }
    }
  }

  .block-content {
    .thead {
      border: 0;
      .td-symbol0 {
        padding-left: 0;
      }
    }
    .tbody .td-symbol {
      padding-left: 0;
    }
  }

  .current-price {
    height 47px
    padding-right: 16px;
    font-size 12px
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    .price {
      margin-left: 15px;
      .sy-price {
        margin-right 5px
        font-size 16px
      }
      .otc-price {
        font-size: 14px;
      }
    }
    .eftJz {
      display: flex;
      .eftJz-title, .eftJz-value {
        line-height: 16px;
        font-size: 14px!important;
      }
      .eftJz-title {
        margin-right: 8px;
        &:hover {
          text-decoration: underline;
        }
        .icon {
          cursor: pointer
        }
      }
    }
    .fade-enter-active, .fade-leave-active {
      transition: all 0.3s ease;
      height: 190px;
    }

    .fade-enter, .fade-leave-to {
      height: 0;
      overflow: hidden;
    }
    .market-show {
      position: absolute;
      width: 230px;
      height: 190px;
      right: 16px;
      bottom: 40px;
      z-index: 99;
      line-height: 20px;
      padding: 15px;
      box-sizing: border-box;
      box-shadow: 0 3px 4px 1px rgba(0,0,0,0.28);
      .arrow {
        position: absolute;
        border-width: 4px;
        border-style: solid;
        right: 36%;
        &.arrow-top {
          border-bottom-color: transparent!important;
          border-left-color: transparent!important;
          border-right-color: transparent!important;
          bottom: -8px;
        }
        &.arrow-bottom {
          border-top-color: transparent!important;
          border-left-color: transparent!important;
          border-right-color: transparent!important;
          top: -8px;
        }
      }
    }
    &.isBuy {
      .market-show {
        top: 40px;
      }
    }

    .eftJz-introduce {
      position: absolute;
      width: 80%;
      left: 10%;
      top: initial!important;
      bottom: 40px;
      z-index: 99;
      line-height: 20px;
      padding: 15px;
      box-sizing: border-box;
      box-shadow: 0 3px 4px 1px rgba(0,0,0,0.28);
      text-align: right;
      p {
        text-align: left;
      }
    }

    .depth-type {
      float right
      margin-right: 15px;
      .num {
        font-size 12px
      }

      .switch-type-btn {
        line-height 15px
        display inline-block
        float right
        margin 13px 0 0 5px
        border-right none

        .icon-switch {
          float left
          width 14px
          height 14px
          margin-left 2px
          text-align center
          cursor pointer

          .hoverShow {
            display none
          }

          &:hover {
            .hoverHide {
              display none
            }

            .hoverShow {
              display inline-block
            }
          }
        }

        .noclick {
          cursor auto
        }
      }
    }
  }

  .switch-btn {
    // float right
    // display: none !important;
    .dtIcon {
      font-size 12px
      margin-right 12px
      cursor pointer
      display inline-block
      height 12px
      line-height 12px
      text-align center
      width 12px
      position: relative;
      img {
        width: 12px;
      }
    }
  }

  .title-tab {
    margin-right 30px
    display none

    &.title-new-tab {
      display none
    }
  }
}
// 中国版
.Chainer {
}

// 国际版
.Int-trade {
  .depath-index-container {
    &.trade-depth-block {
      height calc(100% - 405px)
    }

    .depth, .new-tradb {
      height 100%
    }
  }
}

// 专业版
.new-pro-trade {
  .depth-view {
    height: 100%;
    display: flex;
    flex-direction: column;
    .newTrade-depth-block {
      margin-right: 0;
      .depth {
        height: 463px;
      }
      .block-header {
        border: 0;
        line-height: 1;
      }
    }
  }
}