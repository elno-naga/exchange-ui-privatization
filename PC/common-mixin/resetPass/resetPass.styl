html.en_US {
  .page-resetPass {
    font-family: HarmonyOS-Medium;

    .input_line_prompt {
      font-family: HarmonyOS-Medium;
    }

    .v5-input-content {
      font-family: HarmonyOS-Medium;
    }

    .v5-common-button {
      font-family: HarmonyOS-Medium;
    }
  }
}

.page-resetPass {
  min-height: calc(100vh - 60px);
  font-family: 'PingFang SC';

  .input_line_prompt {
    font-weight: 400;
    font-family: 'PingFang SC medium';
  }

  .v5-input-content {
    font-family: 'PingFang SC';

    input {
      font-size: 14px;
    }
  }

  .v5-common-button {
    font-family: 'PingFang SC';
  }

  .website {
    text-align: center;
    border-bottom-width: 0px;
    border-bottom-style: solid;
    height: 40px;
    line-height: 40px;
  }

  .guide-center {
    p {
      font-family: HarmonyOS-Regular;
      font-size: 32px;
      text-align: center;
      line-height: 52px;
      margin-top: 59px;
    }

    .guide-text {
      margin-top: 12px;
      font-size: 14px;
      text-align: center;
    }
  }

  // 主体
  .page-resetPass-content {
    width: 340px;
    margin: 100px auto 0;

    .content-title {
      font-size: 32px;
      line-height: 52px;
      font-weight: 600;
      white-space: nowrap;
    }

    .precautions {
      margin-top: 8px;
      margin-bottom: 10px;
    }

    .content-center {
      width: 340px;
      margin: 0 auto;

      .resetPassTab {
        margin-bottom: 24px;
      }

      .hidePassword {
        cursor: pointer;
        margin-right: 15px;
      }

      .sub-title {
        font-weight: 500;
        font-size: 14px;
        line-height: 22px;
        margin-top: 20px;
        margin-bottom: 4px;
        width: 340px;
      }
    }
  }

  .copy {
    display: none;
  }
}

// 返回首页按钮
.go-home-btn {
  border-width: 1px;
  border-style: solid;
  height: 30px;
  line-height: 30px;
  width: 110px;
  text-align: center;
  cursor: pointer;
  position: absolute;
  top: 10px;
  right: 20px;
  z-index: 10;
  user-select: none;
  display: none;
}

// 国际版
.Int {
  .page-resetPass {
    .go-home-btn {
      display: block;
    }

    .into-guide-center {
      .guide-center {
        p {
          text-align: left;
        }
      }
    }

    .copy {
      display: block;
      position: absolute;
      bottom: 34px;
      text-align: center;
      font-size: 12px;
      width: 100%;
      left: 0;
    }
  }
}
  .phone_line{
    display :flex;
    flex-direction:row;
  }
.reset_country_code{
  .select-options-box{
    width:338px;
    top:100% !important;
    transform:translate(0,2px);
    .select-option{
      width:320px !important;
    }
  }
}
