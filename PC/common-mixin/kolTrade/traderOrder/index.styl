
.kolTraderOrder{
    width:1200px;
    margin: 0 auto;
    .kolTraderOrder-return{
        display: flex;
        align-items: center;
        img{
            height:16px;
            width:16px;
            margin-right:10px;
        }
        margin: 40px 0 60px;
        font-size: 16px;
        line-height: 22px;
        color: #888FA1;
        span{
            cursor:pointer;
        }
    }
    .kolTraderOrder-info{
       .kolTraderOrder-info-title{
            font-size: 20px;
            line-height: 26px;
            color: #21262B;
            display:flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom:32px;
            .kolTraderOrder-info-titleR{
                font-size: 14px;
                line-height: 18px;
                color: #888FA1;
            }
        }
        .kolTraderOrder-info-box{
            background: #FFFFFF;
            box-shadow: 0px 4px 28px -6px rgba(24, 39, 75, 0.1);
            border-radius: 8px;
            height:88px;
            padding: 22px 32px;
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: space-between;
            .kolTraderOrder-info-boxL{
                display:flex;
                .kolTraderOrder-info-img{
                    position: relative;
                    width: 44px;
                    cursor:pointer;
                    .kolTraderOrder-info-img1{
                        width:44px;
                        height:44px;
                        border-radius:50%;
                    }
                    .kolTraderOrder-info-img2{
                        width:16px;
                        height:16px;
                        position: absolute;
                        bottom: 2px;
                        right: 0px;
                    }
                }
                .kolTraderOrder-info-data{
                    display:flex;
                    flex-direction: column;
                    margin-left: 18px;
                    .kolTraderOrder-info-name{
                        font-size: 16px;
                        line-height: 20px;
                        color: #21262B;
                        margin-bottom:8px;
                    }
                    .kolTraderOrder-info-label{
                        font-size: 12px;
                        line-height: 16px;
                        color: #888FA1;
                        display: flex;
                        align-items: center;
                        img{
                            height:14px;
                            width:14px;
                            cursor: pointer;
                        }
                    }
                }
            }
            .kolTraderOrder-info-boxR{
                cursor:pointer;
                font-size: 14px;
                line-height: 18px;
            }
        }
    }
    .kolTraderOrder-data{
        display:flex;
        justify-content: space-between;
        margin: 40px 0 70px;
        .kolTraderOrder-data-item{
            width:580px;
            background: #FFFFFF;
            box-shadow: 0px 4px 28px -6px rgba(24, 39, 75, 0.15);
            border-radius: 8px;
            padding:28px 32px;
            box-sizing:border-box;
            .kolTraderOrder-data-item-title{
                font-size: 16px;
                line-height: 22px;
                color: #21262B;
                margin-bottom:28px;
            }
            .kolTraderOrder-data-item-box{
                display: flex;
                flex-wrap: wrap;
                justify-content: flex-start;
                color: #16181D;
                .other-info-item{
                    width:150px;
                    margin-right:20px;
                    margin-bottom:20px;
                    .other-info-item-title{
                        font-size: 12px;
                        line-height: 18px;
                        color: #888FA1;
                        margin-bottom:8px;
                    }
                    .other-info-item-val{
                        font-size: 16px;
                        line-height: 22px;
                    }
                    .kolName{
                        max-width: 150px;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        white-space: nowrap;
                    }
                }
                .other-info-item:nth-child(3n-2){
                    margin-right:60px;
                }
                .other-info-item:nth-child(3n-1){
                    width: 120px;
                }
                .other-info-item:nth-child(3n){
                    margin-right:0px;
                    text-align:right;
                }
            }
        }
    }
    .kolTraderOrder-table-title{
        font-size: 20px;
        line-height: 26px;
        color: #21262B;
        margin-bottom:40px;
    }
    .kolTraderOrder-table{
        text-align:center;
        font-size:14px;
        color:#16181D;
        .common-table{
            font-size: 14px !important;
            background: none !important;
        }
        .common-skeleton.skeleton-dark {
            background-color: #E8EBF3 !important;
            background-image: none;
            }
        .fill-6-bg {
            background-color: #E8EBF3 !important;
        }
        .fill-2-bg{
            background: none !important;
        }
        .fill-3-bg{
            background: none !important;
        }
        .fill-4-bg{
            background-color: #E8EBF3 !important;
        }
        .text-1-cl{
            color: #16181D !important;
        }
        .text-2-cl{
            color: #888FA1 !important;
        }
        .fill-6-bd{
            border-color: #E8EBF3 !important;
        }
        .common-table .table-head{
            padding: 0 0 4px;
        }
        .common-table .table-body .tr-bg{
            padding: 0;
        }
        .common-table .table-body .tr-content{
            height:60px;
            line-height:60px;
        }
    }
    .upload{
        .upload-box{
            width: 120px;
            height: 120px;
            border-radius: 50%;
            box-sizing: border-box;
            position: relative;
            cursor: pointer;
            margin: 0 auto 24px;
            img{
                width: 120px;
                height: 120px;
                border-radius: 50%;
            }
        }
        .upload-input{
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            z-index: 2;
            cursor: pointer;
        }
        .upload-btn{
            position: absolute;
            width: 100%;
            height: 100%;
            left: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 1;
            img{
                height:48px;
                width: 48px;
            }
        }
        .upload-cover{
            height: 120px;
            width: 120px;
            background: rgba(0,0,0,0.5);
            position: absolute;
            top: 0;
            border-radius: 50%;
        }
        .upload-note{
            font-size: 14px;
            line-height: 20px;
            color: #888FA1;
            text-align:center;
            margin-bottom:40px;
        }
    }
    .modal-textarea{
        background: #F2F4FB;
        border-radius: 4px;
        width: 100%;
        height: 80px;
        padding: 10px;
        box-sizing: border-box;
        resize: none;
        margin-bottom: 28px;
    }
    .share{
        .share-top{
            padding:20px 16px;
            box-sizing: border-box;
            font-size: 14px;
            line-height: 20px;
            color: #16181D;
            background: #F2F4FB;
            border-radius: 8px;
        }
        .share-bottom{
            padding:16px;
            box-sizing: border-box;
            font-size: 14px;
            line-height: 20px;
            color: #16181D;
            background: #F2F4FB;
            border-radius: 8px;
            margin-bottom: 34px;
            .modal-input{
                width:50px;
                height: 26px;
                border:1px solid #C5C9D5;
                border-radius: 4px;
                box-sizing: border-box;
                text-align: center;
                font-size: 14px;
                color: #131d32;
            }
            .share-bottom-note{
                font-size: 12px;
                line-height: 18px;
                color: #525D79;
                margin-top:8px;
            }
        }
    }
    .amountFlag{
        .amountFlag-title1{
            font-size: 12px;
            line-height: 18px;
            text-align: center;
            color: #16181D;
        }
        .amountFlag-title2{
            font-size: 24px;
            line-height: 32px;
            text-align: center;
            color: #2762FF;
        }
        .amountFlag-title3{
            font-size: 12px;
            line-height: 18px;
            color: #16181D;
            text-align: left;
            margin-bottom: 12px;
        }
        .amountFlag-list{
            .amountFlag-item{
                background: #F2F4FB;
                border-radius: 8px;
                padding:16px;
                box-sizing:border-box;
                margin-bottom:12px;
                .amountFlag-item-li{
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    .amountFlag-item-title{
                        font-size: 12px;
                        line-height: 18px;
                        color: #888FA1;
                    }
                    .amountFlag-item-value{
                        font-size: 14px;
                        line-height: 20px;
                        color: #16181D;
                    }
                }
            }
        }
        .amountFlag-list-nodata{
            text-align:center;
            min-height: 200px;
            img{
                margin-bottom:10px;
                margin-top:50px;
            }
        }
    }
    .dialogTip{
        .fill-2-bg{
            background: #FFFFFF !important;
        }
        .fill-3-bg{
            background: #F2F4FB !important;
        }
        .text-1-cl{
            color: #16181D !important;
        }
        .fill-6-bg {
            background-color: #E8EBF3 !important;
        }
        .text-2-cl {
            color: #888FA1 !important;
        }
    }
    .dialog-frame-body{
        overflow-y: scroll;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .dialog-frame-body::-webkit-scrollbar {
        display: none;
    }
}
