.invite-modal{
  * {
    font-family: HarmonyOS-Medium;
  }

  .__rail-is-vertical {
    display: none;
  }

  .dialog-frame {
    background: #ffffff !important;
  }
  .dialog-frame-head{
    .common-iconButton{
      width:18px;
    }
    .iconButton-icon{
      width: 18px;
      height: 18px;
      position: absolute;
      left: 0;
      top: 9px;
      text-align: center;
      svg{
        display: none;
      }
      &:before{
        display: block;
        content: '';
        width: 14px;
        height: 14px;
        margin: auto;
        margin-bottom: 16px;
        position: absolute;
        background: url(https://saas-osss.oss-accelerate.aliyuncs.com/transfer_dev/upload/20220608201525875.png) no-repeat;
        top: 4px;
        left: 4px;
        background-size: cover;
      }
    }
  }
  .modal-content{
    height: auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .change-img{
    display: flex;
    // height: 480px;
    width:100%;
    justify-content:center;
    align-items: center;
    .left,.right{
      display: flex;
      position:fixed;
      top: 50%;
      transform: translateY(-50%);
      img{
        width:27px;
        cursor: pointer;
      }
    }
    .left{
      text-align: left;
      left:18px;
    }
    .right{
      justify-content: flex-end;
      right:18px;
    }
    .center{
      width: 375px
      min-width:250px;
      height: 100%;
      font-size:0px;
      >div{
        width:100%
      }
      .img{
        text-align: center;
        position:relative;
        z-index:2;
        img{
          width: 100%;
          border-radius: 5px 5px 0 0;
        }
      }
      .info{
        height: 85px;
        display: flex;
        padding:15px 10px 10px;
        box-sizing: border-box;
        justify-content: space-between;
        background: #232326;
        border-radius: 0 0 5px 5px;
        position:relative;
        bottom:5px
        z-index:1;
        .contact{
          width: calc(100% - 75px);
          display: flex;
          flex-direction: column;
          justify-content: center;
          p{
            font-size: 16px;
            font-weight: 600;
            margin: 5px 0;
            color:#fff;
          }
          >div{
            color: #606266;
            font-size: 12px;
            line-height: 1.3;
          }
        }
        .code{
          width:65px;
          display: flex;
          justify-content: center;
          img{
            width:60px;
            height: 60px;
          }
        }
      }
    }
  }
  .download-btn{
    width:100%;
    .down-slot-div{
      display: flex;
      justify-content: center;
      align-items: center;
      .icon{
        margin-right:8px;
      }
    }
    img{
      margin-right: 8px;
    }
  }
}
@media screen and (min-width:1280px) and (max-height:1559px){
  .center{
    width:250px !important;
  }
}
@media screen and (min-width:1660px) and (max-height:1920px){
  .center{
    width:300px !important;
  }
}


