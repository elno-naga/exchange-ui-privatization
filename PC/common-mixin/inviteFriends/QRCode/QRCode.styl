.code-modal{
  * {
    font-family: HarmonyOS-Medium;
  }
  width: 100%;
  height: 100%;
  .bg{
    background-color: rgba(0,0,0,0.5);
    position: fixed;
    width: 100%;
    height: 100%;
    z-index: 999;
    top: 0;
    left: 0;
  }
  .card{
    position: fixed;
    z-index: 1000;
    left: 50%;
    top: 50%;
    transform: translate3d(-50%, -50%, 0);
    width: 480px;
    border-radius: 8px;
    text-align: center;
    min-height:634px;
    max-height: 100vh;
    //background: linear-gradient(to top, #060B17, #0E1A33);
    background-repeat:no-repeat;
    background-size:100%;
    .close{
      position: absolute;
      top: 24px;
      right: 24px;
      width:20px;
      height: 20px;
      cursor: pointer;
      img{
        width:100%;
      }
      .hoverShow {
        display: none;
      }
      &:hover {
        .hoverHide {
          display: none;
        }
        .hoverShow {
          display: inline;
        }
      }
    }
    .title{
      width: 100%;
      height: 178px;
      color: #fff;
      font-size: 32px;
      text-align: center;
      font-weight: 700;
      display: flex;
      flex-direction: row;
      align-items: center;
      line-height: 1.5;
      justify-content: center;
      padding:0 24px;
      box-sizing:border-box;
    }
    .code{
      width: 260px;
      height: 360px;
      background: #fff;
      margin: 0 auto;
      border-radius: 8px;
      -webkit-mask: radial-gradient(circle at left 250px, transparent 10px, red 10px),radial-gradient(circle at right 250px, transparent 10px, red 10px);
      -webkit-mask-position: 0, 100%;
      -webkit-mask-size: 51%;
      -webkit-mask-repeat: no-repeat;
      -moz-mask: radial-gradient(circle at left 250px, transparent 10px, red 10px),radial-gradient(circle at right 250px, transparent 10px, red 10px);
      -moz-mask-position: 0, 100%;
      -moz-mask-size: 51%;
      -moz-mask-repeat: no-repeat;
      .qr-code{
        width:100%;
        height: 250px;
        position:relative;
        box-sizing:border-box;
        .qr-code-border{
          width:220px;
          height:250px;
          position:absolute;
          border-bottom: 1px #cbcbcb dashed;
          left:50%;
          transform:translateX(-50%);
        }
      }
      // .qr-code::before,.qr-code::after{
      //     content: '';
      //     width: 20px;
      //     height: 20px;
      //     border-radius: 50%;
      //     background: rgba(255, 255, 255, 0);
      //     position: absolute;
      //     z-index: 999;
      // }
      // .qr-code::before{
      //     left: -10px;
      //     top: 240px;
      //     }
      // .qr-code::after{
      //     right: -10px;
      //     top: 240px;
      // }
      .invite-code{
        width: 100%;
        text-align: center;
        padding-top: 18px;
        >p{
          color:#21262B;
          font-size: 16px;
          margin-bottom: 14px;
          font-weight:500;
        }
        >div{
          font-size: 28px;
          font-weight: 700;
          line-height:33px;
          font-family: "HarmonyOS Sans SC";
        }
      }
      // &:after {
      //     content: '';
      //     position: absolute;
      //     left: 0;
      //     right: 100%;
      //     top: 230px;
      //     height: 20px;
      //     background: radial-gradient(circle at left center, transparent 20px, red 20px);
      // }
    }

  }
}
