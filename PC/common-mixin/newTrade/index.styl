  //     }
  //   }
  // }
  .trade-limit-text {
    font-size 12px
    line-height 18px
    margin-top 15px
  }

  .trade-noticeDialog {
    .trade-noticeDialog-even {
      margin-bottom: 20px;
      font-size: 14px;
      line-height: 22px;
      span {
        cursor: pointer
      }
    }
  }

  .trade-etf_riskTip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 30px;
    font-size: 12px;
    overflow: hidden;
    box-sizing: border-box;
    padding: 0 30px;
    background: rgba(235,77,92,0.8);
    opacity: 0.8;
    color: #ffffff;
    .riskTip-close {
      text-align: right;
      cursor: pointer;
      img {
        width: 12px;
      }
    }
    a {
      color: #ffffff;
      text-decoration: underline;
    }
    .icon-tip {
      margin-right: 10px;
    }
  }
  
  .newTrade-content {
    display: flex;
    width: 100%;
    overflow: hidden;
    padding-bottom: 5px;
    padding-top: 3px;
    font-family: HarmonyOS-Medium;
    font-weight: 500;
    min-width: 1300px;
    .tradeInfo-block {
      flex: 1;
      margin-right: 5px;
      overflow: hidden;
    }
    .tradeView-block {
      width: 100%;
      display: flex;
    }
    .newTrading-view {
      flex: 1;
    }
    .market-block {
      width: 320px;
      height: 100%;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }
  }


  .trade-shrinks {
    .main-block {
      padding 0 325px 0 105px
    }

    .right-block {
      width 320px
    }
  }

  .trade-content {
    .transaction {
      height 265px
      margin-top 5px
      clear both
    }

    .chart-box {
      position relative
    }
  }

  // 国际版 样式
  .Int-trade {
    .trade-content {
      padding 0 5px 0 0

      .left-block {
        left 0
        top 0
        height 100%
      }

      .right-block {
        top 0
        height 100%
      }

      .transaction {
        height 400px
      }

      .main-block {
        height auto
        min-height 800px
      }
    }
  }

  // 专业版 样式
  .new-pro-trade {
    .newTrade-content {
      height: 1010px;
    }
    .depth-view {
      margin-left: 5px;  
    }
  }

