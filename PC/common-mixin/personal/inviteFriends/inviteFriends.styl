.dialog-div{
      .dialog-div-module{
        padding: 18px 20px 15px 20px;
        border-bottom-style:solid;
        border-width:1px;
        p:nth-of-type(1){
          font-size: 12px;
          margin-bottom: 5px;
        }
        p:nth-of-type(2){
          font-size: 14px;
          span:nth-of-type(2){
            float: right;
          }
        }
        .img-div{
          width:180px;
          height:180px;
          margin-left: 90px;
          border-radius: 2px;
          img{
            width:160px;
            height:160px;
            margin:10px;
          }
        }
      }
    }