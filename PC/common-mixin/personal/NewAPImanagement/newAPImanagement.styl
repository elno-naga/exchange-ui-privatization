.api-mgt-box {
  .ip-permission{
    margin-bottom: 0px
  }
  .copystyle{
    cursor: pointer;
    margin-left: 8px;
  }
  .copyKey{
    display: flex;
    align-items: center
  }
  .copystyles{
    cursor: pointer;
    margin-top: -6px;
    margin-left: 8px;
  }
  .iconClass {
    border-bottom-style: dashed;
    border-bottom-width: 1px;
    padding-bottom: 2px;
  }

  .checkoutBoxOver {
    height: 12px;
    width: 12px;
    display: inline-block;
    position: absolute;
    background: #b4b4ba;
    opacity: .4;
    left: 1px;
    top: 1px;
    border-radius: 2px;
  }

  font-family: HarmonyOS-Medium;

  .appendClass {
    margin-right: 12px;
  }

  button {
    font-family: HarmonyOS-Medium;
  }

  .api-head {
    height: auto;
    box-sizing: border-box;

    .title {
      padding: 32px;
      h2 {
        font-family: HarmonyOS-Medium;
        font-weight: 500;
        font-size: 32px;
        font-style: normal;
        line-height: normal;
      }
    }

    .introduction {
      padding-top:24px;
      padding-left: 32px;
      border-radius: 2px 0 0 0;
      p {
        margin-bottom: 8px;
        font-size: 12px;
        line-height: 14px;

      }
    }

    .search-box {
      margin-top: 32px;
      padding: 0 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;

      >div {
        display: flex;

        .account-select {
          margin-right: 16px;
          padding-top: 10px;
        }
      }
    }
  }

  .divider {
    height: 1px;
    margin-bottom: 20px;
  }

  .api-content {
    padding: 32px;
    padding-bottom: 52px;
    box-sizing: border-box;

    .common-table {

      .sub-content {
        display: flex;
        padding: 24px 0;
      }

      .left-code {
        width: 276px;
        box-sizing: border-box;
        padding: 0 80px 0 32px;

        div {
          width: 164px;
          height: 164px;
          // text-align: center;
          // line-height: 176px;
          border-style: solid;
          border-width: 1px;
          padding: 6px;
          box-sizing: border-box;
          display: flex;
          align-items: center;
          justify-content: center;

          img {
            width: 100%;
          }
        }
      }

      .right-list {
        flex: 1;

        >div {
          margin-bottom: 28px;
        }

        .secret-key,
        .api-permission {
          margin-bottom: 28px;
        }

        .api-key,
        .secret-key {
          .code-box {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            margin-right: 28px;
            margin-top: 12px;
            #copyToken::selection {
              background: transparent;
            }

            #copyKey::selection {
              background: transparent;
            }
          }

          .warning-text {
            margin-top: 12px;
            background: rgba(233, 169, 42, 0.10);
            display: inline-flex;
            border-radius: 2px;
            padding: 4px 8px;
            gap: 8px;
            font-size: 12px;
            align-items: center;
          }
        }

        .api-permission {
          .inputBox {
            display: flex;
            margin-top: 12px;

            >div {
              margin-right: 28px;
              display: flex;
              font-size: 14px;

              input {
                margin-right: 8px;
              }
            }
          }
        }

        .ip-permission {
          margin-bottom: 0px;
          .ip-radio {
            display: flex;
            margin-top: 12px;
            align-items: center;

            p {
              margin-left: 8px;
              font-size: 14px;
            }
          }

          .ip-label {
            margin-top: 28px;
            .label {
              display: flex;
              padding: 20px 0;
              padding-bottom: 0px;

              .label-item {
                margin-right: 17px;
                position: relative;
                border-radius: 11.5px;
                height: 23px;
                line-height: 23px;
                padding: 0px 8px;
                box-sizing: border-box;

                span {
                  position: absolute;
                  display: inline-block;
                  top: -2px;
                  right: -5px;
                  cursor: pointer;
                  border-radius: 6px;
                  width: 12px;
                  height: 12px;
                  line-height: 12px;
                  text-align: center;
                }
              }
            }

            .ip-input {
              .input-bd {
                border: 1px solid;
              }
            }
          }
        }
      }
    }

    .label-col {
      position: relative;

      .long-value {
        visibility: hidden;
        transform: translateY(-5px);
        opacity: 0;
        position: absolute;
        width: 204px;
        padding: 9px 12px;
        left: 0;
        top: 22px;
        box-sizing: border-box;
        box-shadow: 0px 3px 4px 1px rgba(0, 0, 0, 0.28);
        border-radius: 8px;
        word-break: break-all;
        z-index: 2;
        transition: all 0.5s;
      }

      &:hover {
        .long-value {
          visibility: visible;
          opacity: 1;
          transform: translateY(0);
        }
      }
    }

    .content-loading {
      margin-top: 160px;
      text-align: center;
    }

    .table-btn_item {
      float: right;
      position: relative;
      margin-left: 20px;

      .save-button,
      .cancel-button {
        height: 28px !important;
        line-height: 28px !important;
      }

      &:last-child {
        margin-left: 0;
      }
    }

    .no_data {
      .img {
        text-align: center;
        margin-top: 123px;
        margin-bottom: 16px;
      }

      .text {
        text-align: center;
        line-height: 16px;

        span {
          cursor: pointer;
        }
      }
    }
  }

  .add-api-dialog {
    .dialog-frame {
      .dialog-frame-body-content {
        .nullApi {
          .img {
            text-align: center;
            margin-bottom: 26px;
            margin-top: 20px;
          }

          .text {
            text-align: center;
            margin-bottom: 80px;

            span {
              cursor: pointer;
            }
          }
        }

        .addAPIform {
          >div {
            padding-top: 24px;

            &:first-child {
              padding-top: 0;
            }
          }
        }
      }
    }
  }

  .saveVerifyDialog {
    .verifyForm-saveCode-phone {
      margin-top: 24px;
    }
  }

  .copyValue {
    position: absolute;
    left: -9999px;
    top: -9999px;
  }
}
