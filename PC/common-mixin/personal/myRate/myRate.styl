.my-rate {
  width: 1200px;
  margin: auto;
  overflow: hidden;
  padding-bottom: 80px;
  .common-table .table-head .th:last-child {
    text-align: right;  
  }
  .c_list_nav_item{
    margin-right: 16px !important;
    }
  .alop3{
    margin-right: -16px !important;  
  }
  .select-options-box {
    top: 32px !important;
  }
  .line-select-1{
    display: flex;
    align-items: center;
    }
    .switchWrap{
      margin: 8px 0px;
      }
  .rate-title {
    font-size: 24px;
    line-height: 92px;
    font-weight: 500;
    margin-bottom: 28px;
  }

  .rate-vip {
    display: flex;
    margin-bottom: 40px;
    align-items: center;

    > svg {
      margin-right: 24px;
    }

    .vip-level {
      font-size: 14px;
      line-height: 16px;
      font-weight: 500;
      margin-bottom: 8px;
    }

    .vip-type {
      font-size: 24px;
      line-height: 28px;
      font-weight: 500;
    }

    .invite-friends {
      border-radius: 4px;
      padding: 0 12px;
      height: 32px;
      line-height: 32px;
      display: flex;
      align-items: center;
      cursor: pointer;

      > svg {
        margin-right: 8px;
      }
    }
  }

  .rate-view {
    display: flex;
    gap: 24px;
    border-radius: 12px;

    .view-item {
      flex: 1;
      padding: 32px;
      display: flex;
      margin-bottom: 8px;
      flex-direction: column;
      border-radius: 12px;

      .item-line {
        display: flex;

        &-one {
          justify-content: space-between;
          margin-bottom: 28px;

          h2 {
            font-weight: 500;
            font-size: 20px;
          }

          .item-link {
            display: flex;
            align-items: center;

            .hoverHide {
              display: inline-block;
            }

            .hoverShow {
              display: none;
            }

            &:hover {
              .hoverShow {
                display: inline-block;
              }

              .hoverHide {
                display: none;
              }
            }

            svg {
              margin-left: 2px;
            }
          }
        }

        &-two {
          margin-top: 16px;
          justify-content: flex-start;
          margin-bottom: 4px;

          .line-half {
            flex: 1;

            .view-key {
              font-weight: 500;
              font-size: 12px;
              margin-bottom: 8px;
            }

            .view-value {
              font-weight: 500;
              font-size: 18px;
              margin-right: 4px;
            }

            .view-delete {
              font-size: 12px;
              text-decoration: line-through;
            }
          }
        }

        &-loan {
          margin-bottom: 12px;

          .line-select {
            display: flex;
            gap: 8px;
            width: 100%;

            &-1 {
              width: 120px;
              padding: 8px 12px;
              border-radius: 4px;
            }

            &-2 {
              width: 192px;
            }
          }
        }

        &-three {
          justify-content: space-between;

          .daily-key {
            font-weight: 500;
            font-size: 12px;
          }

          .daily-value {
            font-weight: 500;
            font-size: 16px;
          }
        }
      }
    }
  }

  .rate-handling {
    display: flex;
    font-size: 12px;
    line-height: 18px;
    font-weight: 500;
    margin-bottom: 80px;
    padding-right: 5px;
    align-items: center;
    height: 28px;

    .handling-text {
      margin-right: 8px;
    }

    .circleChecked {
      left: -2px !important;
    }
  }

  .rate-process {
    border-radius: 12px;
    border-width: 1px;
    border-style: solid;
    margin-top: 80px;
    margin-bottom: 80px;

    .process-head {
      padding: 32px;
      font-weight: 500;
      border-radius: 12px 12px 0 0;

      h2 {
        margin-bottom: 12px;
        font-size: 20px;
        line-height: 23px;
      }
    }

    .process-body {
      padding: 32px;

      .requirements {
        font-size: 16px;
        line-height: 19px;
        font-weight: 500;
        margin-bottom: 28px;
      }

      .requirements-body {
        display: flex;
        gap: 60px;
        align-items: center;
        margin-bottom: 8px;

        .requirements-info {
          flex: 1;

          .process-one {
            font-size: 14px;
            line-height: 16px;
            font-weight: 500;
            margin-bottom: 12px;
          }

          .process-two {
            font-size: 24px;
            line-height: 28px;
            font-weight: 500;
            margin-bottom: 28px;
          }

          .process-three {
            margin-bottom: 20px;

            .schedule {
              width: 200px;
              height: 4px;
              border-radius: 2px;

              &-checked {
                height: 4px;
                border-radius: 2px;
              }
            }
          }

          .process-four {
            font-size: 14px;
            line-height: 16px;
            font-weight: 500;
            margin-bottom: 8px;
            cursor: pointer;

            .hoverHide {
              display: inline-block;
            }

            .hoverShow {
              display: none;
            }

            &:hover {
              .hoverShow {
                display: inline-block;
              }

              .hoverHide {
                display: none;
              }
            }
          }
        }

        .delimiter {
          width: 40px;
          height: 40px;
          border-radius: 100%;
          display: flex;
          justify-content: center;
          align-items: center;
          box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.1);
        }
      }

      .line {
        margin: 32px 0 40px;
        width: 100%;
        height: 1px;
      }
    }
  }

  .rate-procedure {
    display: flex;
    flex-direction: column;
    margin-top: 80px;

    h2 {
      font-size: 20px;
      line-height: 23px;
      font-weight: 500;
      margin-bottom: 12px;
    }

    .rate-navTab {
      display: flex;
      justify-content: space-between;
      align-items: center;

      .nav-tab.common-navTab .c_list_nav li {
        span {
          font-size: 16px;
        }

        padding: 20px 0 16px;
      }
    }

    .note {
      padding: 12px 16px;
      background: rgba(233, 169, 42, 0.1);
      color: #FAAD14;
      font-size: 14px;
      line-height: 20px;
      font-weight: 500;
      margin-bottom: 24px;
      border-radius: 4px;
    }

    .description {
      margin-top: 40px;
      font-size: 14px;

      .description-title {
        font-weight: 500;
        line-height: 16px;
        margin-bottom: 16px;
      }

      .description-content {
        line-height: 20px;
        margin-bottom: 12px;
      }
    }
  }
}