.overview-chars {
  // border-bottom-width: 10px;
    // border-bottom-style: solid;
    border-radius: 8px;
    margin-bottom: 10px

  .overviewChars-header {
    line-height: 20px;
    padding: 18px 26px;

    .overviewChars-header-tit {
      float: left;
    }

    .overviewChars-header-text {
      float: right;
      font-size: 12px;
    }
  }

  .overviewChars-content {
    padding: 0 26px 10px 26px;
    margin-top: -10px;

    // .overviewChars-content-left {
    // float: left;
    // width: 590px
    // }
    .overviewChars-content-right {
      float: right;
    }

    .overviewChars-content-sumT {
      font-size: 12px;
      height 18px;
      line-height: 18px;
    }

    .overviewChars-text-bat {
      width: 20%;
      overflow: hidden;
      display: inline-block;

      .overviewChars-text-tag {
        display: inline-block;
        min-width: 40px;
        text-align: center;
      }
    }

    .overviewChars-content-sumV {
      height 28px;
      line-height: 28px;
      font-size: 20px;
      padding-top: 8px;
      padding-bottom: 14px;
      border-bottom-width: 1px;
      border-bottom-style: solid;
    }

    .overviewChars-content-mess {
      margin-top: 20px;
    }

    .overviewChars-content-messL {
      float: left;
      width: 200px;
    }

    .overviewChars-content-messR {
      float: right;
      width: 200px;
    }

    .overviewChars-content-messT {
      font-size: 12px;
    }

    .overviewChars-content-messV {
      font-size: 22px;
      margin-top: 8px;
      margin-bottom: 12px;
    }

    .overviewChars-content-messC {
      width: 200px;
      height: 30px;
      line-height: 30px;
      padding: 0 12px;
      box-sizing: border-box;
      font-size: 12px;
    }

    .overviewChars-content-messCK {
      float: left;
    }

    .overviewChars-content-messCV {
      float: right;
    }

    .overviewChars-bar {
      width: 260px;
      height: 140px;
    }

    .overviewChars-content-rightT {
      width: 140px;
      text-align: center;
      font-size: 12px;
      margin-bottom: 20px;
      margin-top: 10px;
    }
  }

  .overviewChars-line {
    padding: 15px 26px;
  }

  .overviewChars-line-title {
    font-size: 12px;
    // margin-bottom: 10px;
  }

  .overviewChars-line-charts {
    height: 300px;
    width: 100%;
  }
}