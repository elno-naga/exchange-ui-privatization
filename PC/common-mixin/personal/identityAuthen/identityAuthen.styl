.identity-authen{
    width:100%;
    .authen-title {
        font-size: 14px;
        line-height: 55px;
        border-bottom-width: 1px;
        border-bottom-style: solid;
        padding-left: 15px;
    }
    .authen-content-list{
        margin-top:40px;
        display:flex;
        justify-content:center;
        flex-wrap:wrap;
    }
    .authen-content{
        width:100%;
        display:flex;
        justify-content:center;
    }
    .authen-content-item{
        //min-width:278px;
        //max-width:390px;
        width:auto;
        height:auto;
        border-width: 1px;
        border-style: solid;
        display:flex;
        flex-direction:column;
        border-radius:4px;
        padding-bottom:60px;
        position: relative;
        margin-bottom:20px;
        .footer{
            position:absolute;
            left:0;
            bottom:0;
        }
    }
    .arrows{
        padding:0 10px;
        display:flex;
        align-items:center;
    }
    .content-item-header{
        padding:14px 20px;
        display:flex;
        justify-content:space-between;
        border-top-left-radius:4px;
        border-top-right-radius:4px;
        border-bottom-width: 1px;
        border-bottom-style: solid;
        span{
            line-height:20px;
            font-size:16px;
            font-weight:600;
        }
        span.active{
            font-size:14px;
            display: flex;
            align-items: center;
            .iconMargin{
                margin-right:5px;
            }
        }
    }
    .content-item-header.active{
        //border-color:transparent;
        .active{
            color:#00B595 !important;
        }
    }
    .content-item-center{
        border-bottom-width: 1px;
        border-bottom-style: solid;
    }
    .rights-list{
        padding:20px;
        li{
            height:40px;
            line-height:40px;
            font-size:14px;
            display:flex;
            justify-content:space-between;
            align-items:center;
        }
        .rights-list-title{
            justify-content:flex-start;
            font-size:16px;
        }
        .rights-list-titleIcon{
            margin-right:5px;
        }
    }
    .demand-list{
        height:auto !important;
        flex-wrap:wrap;
        align-items:self-start !important;
        justify-content:start !important;
        span{
            margin-right:20px;
            line-height:34px;
        }
    }
    .content-item-center-border{
        border-bottom-width: 1px;
        border-bottom-style: solid;
        margin:0 20px;
    }
    .footer{
        width:100%;
        box-sizing: border-box;
        padding:0 20px 20px;
    }

    .user-management-child-header {
        font-size 14px
        padding 18px 0 18px 20px
        border-bottom-width 1px
        border-bottom-style solid
        box-sizing border-box
    }

    .sumsubCenter{
        height:auto;
        min-height:543px;
    }
    img.rights-list-titleIcon{
        width:20px;
        height:20px;
        margin-right:5px;
    }
    .no-data{
        width:100%;
        min-height:400px;
        display:flex;
        flex-direction: column;
        align-items:center;
        justify-content: center;
    }
    .text-Color{
        color:#fff !important;
    }
  }
