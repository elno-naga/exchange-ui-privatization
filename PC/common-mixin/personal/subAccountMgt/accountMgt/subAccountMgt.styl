.sub_account_box{
    font-family: HarmonyOS-Medium ;
    border-radius: 8px 8px 0 0;
    button{
        font-family: HarmonyOS-Medium ;
    }
    .subAccountTittle{
      font-size: 32px;
      font-style: normal;
      font-weight: 500;
      line-height: normal;
      padding: 32px;
    }
    .sub_head{
        display: flex;
        justify-content: space-between;
        padding: 32px;
        border-radius: 2px 0px 0 0;
        .title{
            font-size: 20px;
        }
        .option{
            display: flex;
            >div{
                margin-right: 16px;
                &:last-child{
                    margin-right: 0;
                }
            }
        }
    }
    .sub_content{
      padding: 0 32px;
        .common-table{
          //height: calc(980px - 81px);
            .table-btn_item {
                float: right;
                position: relative;
                margin-right: 17px;
                &:first-child {
                    margin-right: 0;
                    padding: 0;
                }
                &.detail-visible {
                    // 三角旋转180度
                    .icon-triangle {
                        transform: rotate(360deg);
                        cursor: pointer;
                    }
                }
                &.detail-visible2 {
                    // 三角旋转180度
                    .icon-triangle {
                        transform: rotate(180deg);
                        cursor: pointer;
                    }
                }
                .icon-triangle {
                    position: absolute;
                    right: 12px;
                    transition: all .3s ease-in-out;
                    position: absolute;
                    right: -17px;
                    top: 23px;
                    width: 16px;
                    height: 16px;
                    line-height: 16px;
                    text-align: center;
                    display: inline-block;
                    .icon {
                        width: 0.5em;
                        vertical-align: 0;
                    }
                }
            }
            .normal{
                color: #00B595;
            }
            .freeze{
                color: #FAAD14;
            }
            .tr-content{
                .operation{
                    position: relative;
                    height: 60px;
                    line-height: 60px;
                    .more-option-box{
                        position: absolute;
                        top: 45px;
                        right: 0px;
                        min-width: 88px;
                        max-height: 300px;
                        text-align: center;
                        padding: 12px 2px;
                        z-index: 99;
                        box-sizing: border-box;
                        border: 1px solid ;
                        box-shadow: 0px 3px 4px 1px rgba(0,0,0,0.28);
                        border-radius: 4px;
                        white-space: nowrap;
                        >li{
                            height: 36px;
                            text-align: left;
                            width:100%;
                            box-sizing: border-box;
                            line-height: 36px;
                            box-sizing: border-box;
                            margin-bottom: 4px;
                            padding: 0 12px;
                            &:hover{
                                // background: #0B1726;
                                border-radius: 4px;
                                cursor: pointer;
                            }
                        }
                        .disableText{
                            color: #525D79;
                        }
                    }
                }
            }
        }
        .content-loading{
            margin-top: 160px;
            text-align: center;
        }
        .no_data{
            margin-top: 160px;
            text-align: center;
            .text{
                margin-top: 26px;
                span{
                    cursor: pointer;
                }
            }
        }
        .label-col{
            position: relative;
            .col-value{
               margin-left: 8px;
            }
            >div{
                display: flex;
                align-items: self-end;
                .long-value {
                    visibility: hidden;
                    transform: translateY(-5px);
                    opacity: 0;
                    position: absolute;
                    width: 204px;
                    padding: 9px 12px;
                    left: 0;
                    top: 22px;
                    box-sizing: border-box;
                    box-shadow: 0px 3px 4px 1px rgba(0,0,0,0.28);
                    border-radius: 8px;
                    word-break: break-all;
                    z-index: 2;
                    transition: all 0.5s;
                }
                &:hover {
                    .long-value {
                        visibility: visible;
                        opacity: 1;
                        transform: translateY(0);
                    }
                }
            }

        }
    }
    .check-info-img{
      font-size: 18px;
      font-style: normal;
      font-weight: 500;
      line-height: normal;
      text-align: center;
    }
    //.dialog-frame-bottom{
    //  padding-top: 24px !important;
    //}
}
