.futuresData {
  padding: 5px 0 10px 0;
  padding-bottom: 105px;
  .futuresData-content, .data-content {
     width: 1200px;
    margin: 0 auto;
    padding: 10px 0;
    // .input_line_content {
    //   background: none !important;
    // }
  }
  .rule-update {
    line-height: 24px;
  }
  .navTabName{
    padding:0 24px;
    border-bottom-width:1px;
    border-bottom-style:solid;
  }
  .mining-tit {
    height: 54px;
    line-height: 52px;
    padding: 0 20px;
    border-bottom-width: 1px;
    border-bottom-style: solid;
    margin-bottom: 18px;
    .item {
      display: inline-block;
      font-size: 14px;
      margin-right: 50px;
      height: 51px;
      user-select: none;
      cursor: pointer;
      position: relative;
      .selected {
        width: 40px;
        border-bottom-width: 2px;
        border-bottom-style: solid;
        display: block;
        margin: 0 auto;
      }
    }
    .search {
      float: right;
      line-height: 28px;
      margin-top: 14px;
      .common-button {
        float: left;
      }
    }
  }
  .tableCenter{
    padding:0 24px;
  }
  .filter-box {
    height: 65px;
    padding: 15px 20px 0 20px;
    & > div{
      margin-right:10px;
    }
    .common-select, .input-line-content {
      float: left;
      margin-right: 20px;
      z-index: 99;
    }
  }
  .more-link {
    padding: 20px;
    text-align: right;
    span {
      cursor: pointer;
    }
  }
  .con-text {
    padding: 10px 0 0 25px;
  }
  .chartbox {
    width: 100%;
    height: 400px;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .common-table {
    background: none !important;
    .table-head th,
    .table-body td {
      text-align: center;
    }
  }
  .echartsKline {
    position: relative;
    padding: 20px;
  }
   .futures-info-table {
    position: relative;
    padding: 20px;
  }
}
.futuresDataLever {
  padding-bottom: 365px !important;
}
