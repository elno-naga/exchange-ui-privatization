html.en_US {
  .page-register {
    font-family: HarmonyOS-Medium;

    .input_line_prompt {
      font-family: HarmonyOS-Medium;
    }

    .v5-input-content {
      font-family: HarmonyOS-Medium;
    }

    .v5-common-button {
      font-family: HarmonyOS-Medium;
    }
  }
}

.page-register {
  min-height: calc(100vh - 60px);
  font-family: 'PingFang SC';

  .input_line_prompt {
    font-weight: 400;
    font-family: 'PingFang SC medium';
  }

  .v5-input-content {
    font-family: 'PingFang SC';

    input {
      font-size: 14px;
    }
  }

  .v5-common-button {
    font-family: 'PingFang SC';
  }

  .website {
    text-align: center;
    border-bottom-width: 1px;
    border-bottom-style: solid;
    height: 40px;
    line-height: 40px;
  }

  // 主体
  .page-register-content {
    width: 340px;
    margin: 0 auto 0;
    padding-top: 100px;

    .content-title {
      font-size: 32px;
      line-height: 52px;
      font-weight: 600;
      white-space: nowrap;
    }

    .content-center {
      width: 340px;
      margin: 0 auto;

      .hidePassword {
        cursor: pointer;
        margin-right: 15px;
      }

      .guide-text {
        font-size: 12px;
        line-height: 20px;
        margin-top: 10px;

        .link {
          cursor: pointer;
          // margin-left: 5px;
        }
      }

      .userNone {
        li {
          cursor: no-drop !important;
        }
      }

      .registerTab {
        margin-bottom: 24px;
      }

      .sub-title {
        font-weight: 500;
        font-size: 14px;
        line-height: 22px;
        margin-top: 20px;
        margin-bottom: 4px;
        width: 340px;
      }

      .country-phone {
        position: absolute;
        left: 90px;
        bottom: 0;
      }

      // 忘记密码
      .resgister-opions {
        font-size: 12px;
        margin-top: 40px;
        margin-bottom: 10px;
        display: flex;
        align-items: flex-start;

        .icon {
          vertical-align: -0.2em;
        }

        .common-checkout {
          vertical-align: middle;
        }

        .text {
          user-select: none;
          display: inline-block;
          vertical-align: middle;
          margin-left: 6px;
          line-height: 16px;
          cursor: pointer;
        }

        a {
          vertical-align: middle;
          line-height: 16px;
          font-size: 12px;
          height: 14px;
          margin-left: 4px;
        }

        .goLogin {
          font-size: 12px;
          padding: 0 5px !important;
        }

        .link {
          cursor: pointer;
          margin-left: 5px;
          text-decoration: underline;
        }
      }
    }
  }

  .copy {
    display: none;
  }

  .select-options-box {
    top: 90px!important;
  }
}

// 返回首页按钮
.go-home-btn {
  border-width: 1px;
  border-style: solid;
  height: 30px;
  line-height: 30px;
  width: 110px;
  text-align: center;
  cursor: pointer;
  position: absolute;
  top: 10px;
  right: 20px;
  z-index: 10;
  user-select: none;
  display: none;
}

// 国际版
.Int {
  .page-register {
    .page-register-content {
      padding-bottom: 60px;
      position: relative;
    }

    .go-home-btn {
      display: block;
    }

    .into-guide-center {
      .guide-center {
        p {
          text-align: left;
        }

        .guide-text {
          text-align: right;
        }
      }
    }

    .copy {
      display: block;
      position: absolute;
      bottom: 34px;
      text-align: center;
      font-size: 12px;
      width: 100%;
      left: 0;
    }
  }
}
